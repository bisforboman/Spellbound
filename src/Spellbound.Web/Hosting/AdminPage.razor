@page "/admin"
@attribute [Authorize(Policy = AdminPolicy.Name)]
@using System.Globalization
@using System.Security.Claims
@inject AdminService Admin
@inject Microsoft.Extensions.Options.IOptions<AdminPageOptions> Sections
@inject AlertSink Alerts
@inject IConfiguration Configuration

<PageTitle>Admin</PageTitle>
<h1>Admin</h1>

@if (status is not null)
{
    <p class="alert alert-info" role="status">@status</p>
}

<h2 class="h4">Games</h2>
@if (games.Count == 0)
{
    <p class="text-muted">No games are running.</p>
}
@foreach (var running in games)
{
    var hosted = running.Game;
    <div class="admin-player">
        <div>
            <b>Game @hosted.Id</b> <span class="text-muted">· @running.Description</span>
            <small class="text-muted d-block">Started @Utc(hosted.Round.StartsAt) · ends by @Utc(hosted.Round.EndsAt)</small>
            <small class="d-block">@(running.Players.Count == 0 ? "No players, only bots." : string.Join(", ", running.Players))</small>
        </div>
        @if (confirmEnd != hosted.Id)
        {
            <button type="button" class="btn btn-outline-danger w-100 mt-2" disabled="@busy" @onclick="() => confirmEnd = hosted.Id">End game @hosted.Id now…</button>
        }
        else
        {
            <div class="alert alert-warning mt-2 mb-0">
                <p>This ends game @hosted.Id where it stands. Nobody can play it after this. It can't be undone.</p>
                <button type="button" class="btn btn-danger btn-lg w-100" disabled="@busy" @onclick="() => EndNowAsync(hosted.Id)">Yes, end game @hosted.Id now</button>
                <button type="button" class="btn btn-link btn-lg w-100" @onclick="() => confirmEnd = null">Cancel</button>
            </div>
        }
    </div>
}

<h2 class="h4 mt-4">Backups</h2>
@if (!Admin.BackupsEnabled)
{
    <p class="text-muted">Backups are off. Set <code>Backup:Directory</code> to turn on nightly backups.</p>
}
else
{
    <p>Last backup: @(Admin.LastBackupAt() is { } last ? Utc(last) : "none yet"). A new one is taken every night.</p>
    <button type="button" class="btn btn-outline-primary btn-lg w-100" disabled="@busy" @onclick="BackUpNowAsync">Back up now</button>
}

<h2 class="h4 mt-4">Players</h2>
@if (players.Count == 0)
{
    <p class="text-muted">Nobody is playing a game, and nobody is banned.</p>
}
@foreach (var player in players)
{
    <div class="admin-player">
        <div>
            <b>@(player.Player?.Name ?? "(not in a running game)")</b>
            @if (player.Player is not null)
            {
                <span class="text-muted"> · @player.Player.Details</span>
            }
            <small class="text-muted d-block">@(player.Email ?? player.OwnerId)</small>
        </div>

        @if (player.Ban is { } ban)
        {
            <p class="text-danger mb-1">Banned @Utc(ban.At) by @ban.By: @ban.Reason</p>
            <button type="button" class="btn btn-outline-secondary w-100" disabled="@busy" @onclick="() => UnbanAsync(player.OwnerId)">Unban</button>
        }
        else if (banning == player.OwnerId)
        {
            <label class="form-label" for="reason">Reason</label>
            <input id="reason" class="form-control" maxlength="@AdminService.MaxReasonLength" @bind="reason" @bind:event="oninput" />
            <button type="button" class="btn btn-danger w-100 mt-2" disabled="@(busy || string.IsNullOrWhiteSpace(reason))" @onclick="() => BanAsync(player.OwnerId)">Confirm ban</button>
            <button type="button" class="btn btn-link w-100" @onclick="() => banning = null">Cancel</button>
        }
        else if (player.OwnerId != adminOwnerId)
        {
            <button type="button" class="btn btn-outline-danger w-100" disabled="@busy" @onclick="() => { banning = player.OwnerId; reason = string.Empty; }">Ban…</button>
        }
    </div>
}

<h2 class="h4 mt-4">Problems</h2>
<p class="text-muted">
    Errors since the app last started (unhandled errors, failed backups, a backup over a day old), newest first.
    @(Configuration["Alerts:WebhookUrl"] is { Length: > 0 }
        ? "Each kind is also pushed to your alert webhook, at most once an hour."
        : "Set Alerts:WebhookUrl to get them pushed to your phone or Discord (see docs/deploy.md).")
</p>
@if (Alerts.Recent.Count == 0)
{
    <p>None.</p>
}
@foreach (var problem in Alerts.Recent)
{
    <div class="admin-player">
        <small class="text-muted d-block">@Utc(problem.At) · @problem.Source@(problem.Exception is { } type ? $" · {type}" : "")</small>
        <div>@problem.Message</div>
    </div>
}

<h2 class="h4 mt-4">Shared networks</h2>
<p class="text-muted">
    Accounts that signed in from the same network in the last 30 days. Families, schools and mobile
    carriers share networks too, so this is a hint to look closer, not proof.
</p>
@if (sharedNetworks.Count == 0)
{
    <p class="text-muted">None.</p>
}
@foreach (var network in sharedNetworks)
{
    <div class="admin-player">
        <b>Network @network.Network</b> <small class="text-muted">last seen @Utc(network.LastSeen)</small>
        <ul class="mb-0">
            @foreach (var player in network.Players)
            {
                <li>
                    @(player.Email ?? player.OwnerId)@(player.Player is { } summary ? $" · {summary.Name}, {summary.Details}" : " · not in a running game")
                    @if (player.Ban is not null)
                    {
                        <span class="text-danger"> · banned</span>
                    }
                </li>
            }
        </ul>
    </div>
}

@foreach (var section in Sections.Value.GameSections)
{
    <DynamicComponent Type="section" />
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string adminOwnerId = string.Empty;
    private string adminEmail = string.Empty;
    private IReadOnlyList<AdminGame> games = [];
    private IReadOnlyList<AdminPlayer> players = [];
    private IReadOnlyList<AdminSharedNetwork> sharedNetworks = [];
    private long? confirmEnd;
    private string? banning;
    private string reason = string.Empty;
    private string? status;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        adminOwnerId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        adminEmail = user.Identity?.Name ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        games = await Admin.GetRunningGamesAsync();
        players = await Admin.GetPlayersAsync();
        sharedNetworks = await Admin.GetSharedNetworksAsync();
    }

    private Task EndNowAsync(long id) => RunAsync(() => Admin.EndGameNowAsync(id));

    private Task BanAsync(string ownerId) => RunAsync(() => Admin.BanAsync(adminOwnerId, adminEmail, ownerId, reason));

    private Task UnbanAsync(string ownerId) => RunAsync(() => Admin.UnbanAsync(ownerId));

    private Task BackUpNowAsync() => RunAsync(Admin.BackUpNowAsync);

    private async Task RunAsync(Func<Task<string>> action)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            status = await action();
            confirmEnd = null;
            banning = null;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private static string Utc(DateTimeOffset at) => at.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture);

    private static string N(int value) => value.ToString("N0", CultureInfo.InvariantCulture);
}
