@page "/match/{Id:long}"
@attribute [Authorize]
@inject MatchPlay Play
@inject TimeProvider Time
@inject NavigationManager Nav
@implements IDisposable
@inject IConfiguration Config

<PageTitle>Match @Id</PageTitle>

@if (loading)
{
    <p class="text-muted">Loading…</p>
}
else if (view is null)
{
    <h1>Not found</h1>
    <p>There is no match @Id that you sit in. <a href="">Back home</a></p>
}
else
{
    var match = view.Match;
    var me = match.Seats[you];
    var playing = view.IsRunning && !view.Away.Contains(you);
    // The start of a match in steps: a welcome, the trait (the map stays dark), then the map and the first auction.
    var drafting = playing && match.Phase == MatchPhase.Opening && me.Offer.Count > 0 && me.Trait is null && !view.Committed.Contains(you);
    // A round that began while the page was open plays a short animation: a banner and what each tile paid.
    var fresh = newRound == match.CurrentRound && match.Phase == MatchPhase.Rounds && replay is null; // after any auction playback
    // Tiles go by name from the rounds on; in the opening the map marks the tile up now, and names are only clutter.
    var named = match.Phase != MatchPhase.Opening;
    <div class="match-page">
    @if (fresh)
    {
        <div class="round-banner" @key="newRound" aria-hidden="true">
            <b>Round @match.CurrentRound of @match.Rules.Rounds</b>
            <span>You collect @me.ProducedThisRound mana</span>
        </div>
    }
    <h1>Match @Id</h1>
    <p class="match-status">
        <b>@MatchStore.Describe(match, view.IsRunning)</b>.
        You are seat @(you + 1), in <span class="seat-ink" style="--seat: @Seats.Ink(you)">your ink</span>:
        <span class="ledger-line">@($"{me.Mana} mana")@if (fresh)
            {
                <span class="mana-gain" @key="newRound" aria-hidden="true"> +@me.ProducedThisRound</span>
            }, @me.Tiles.Count @(me.Tiles.Count == 1 ? "tile" : "tiles"), @me.Score @(me.Score == 1 ? "point" : "points").</span>
    </p>

    @if (me.Trait is { } mine)
    {
        <p class="trait-line">Your trait: <b>@mine</b>, @match.GoalText(mine)</p>
    }

    @if (!drafting)
    {
        <section id="map">
        <HexMap Match="match" You="you" Owners="view.Owners" Selected="@(ReplayTile ?? selected)" Highlight="@(replay is null ? auction : null)" OnSelect="Select" ShowNames="named"
                Unowned="@ReplayPending"
                Gains="@(fresh ? match.Seats.SelectMany(s => s.Tiles).ToDictionary(h => h, match.IncomeOf) : null)" />

        @if (selected is { } tile)
        {
            <p class="tile-panel">@Seats.Describe(match, tile, you, view.Owners, named: named)@(auction.Contains(tile) ? ", up for auction" : "").</p>
        }
        </section>
    }

    @if (replay is { } beats)
    {
        // The auction plays back one line at a time, so the player sees each tile's bids, then who got it.
        <section id="playback">
        <h2 class="h4">The auction</h2>
        <div class="match-report playback">
            @for (var b = 0; b < replayBeat && b < beats.Count; b++)
            {
                <p class="@(b == replayBeat - 1 ? "beat-now" : "")" @key="b">@Seats.Phrase(TileNames.In(match.Map, beats[b], named), view.Owners, you)</p>
            }
        </div>
        <button type="button" class="btn btn-link" @onclick="SkipReplay">Skip</button>
        </section>
    }
    else
    {
    <section id="orders">
    @if (status is not null)
    {
        <p class="alert alert-warning" role="alert">@status</p>
    }

    @if (view.IsRunning && view.Away.Contains(you))
    {
        <p class="commit-line">A bot plays your seat now: @(view.Missed.GetValueOrDefault(you) >= MatchStore.MissesBeforeBot
            ? "you missed two deadlines in a row" : "the host handed it over"). You can still watch the match to its end.</p>
    }
    else if (view.IsRunning && view.People.Count() > 1 && match.Phase != MatchPhase.Ended)
    {
        <p class="commit-line">@(view.Committed.Contains(you)
            ? "Everyone gives orders in secret; the step resolves when all players have committed. Until then you can take yours back."
            : view.Committed.Count > 0
                ? $"{string.Join(" and ", view.Committed.Order().Select(p => $"Seat {p + 1}"))} committed and {(view.Committed.Count == 1 ? "waits" : "wait")} on you."
                : "Everyone gives orders in secret; the step resolves when all players have committed.")</p>
        @if (view.DueAt is { } due)
        {
            <p class="commit-line">Due in <b>@Until(due)</b>: whoever hasn't committed by then holds (in the opening, passes).
                @(view.Missed.GetValueOrDefault(you) > 0 ? "You missed the last deadline: miss this one too and a bot takes your seat." : "")</p>
        }
    }

    @if (playing && view.Committed.Contains(you))
    {
        <div class="action-bar">
            <p class="action-sum">You have committed. Waiting for @string.Join(" and ", view.InStep.Where(p => !view.Committed.Contains(p)).Select(p => $"Seat {p + 1}")).</p>
            <div class="action-row">
                <button type="button" class="btn btn-outline-primary btn-lg" disabled="@busy" @onclick="LoadAsync">Refresh</button>
                <button type="button" class="btn btn-primary btn-lg" disabled="@busy" @onclick="WithdrawAsync">Take back</button>
            </div>
        </div>
    }
    else if (drafting && !welcomed)
    {
        <StartSteps Step="1" />
        <h2 class="h4">Welcome to match @Id</h2>
        <p>You play seat @(you + 1) against @string.Join(" and ", match.Seats.Where(s => s.Index != you).Select(s => Seats.Name(view, s.Index, you))).
            The map lies dark; this is how the match goes:</p>
        <ol class="start-plan">
            <li><b>Choose your trait</b>: a secret goal, scored at the end.</li>
            <li><b>The opening</b>: @match.Rules.OpeningUnveils auctions reveal the map, a tile for each player at a time.
                Bid mana on the tile up now, or wait for the next; whoever wins none gets the last one free.</li>
            <li><b>@match.Rules.Rounds rounds</b>: each round, attack, attune or summon. Points are banked every round,
                and the most points wins.</li>
        </ol>
        <div class="action-bar">
            <p class="action-sum">First, your trait.</p>
            <div class="action-row">
                <button type="button" class="btn btn-primary btn-lg" @onclick="() => welcomed = true">Next: choose your trait</button>
            </div>
        </div>
    }
    else if (drafting)
    {
        <StartSteps Step="2" />
        <h2 class="h4">Choose your trait</h2>
        <p>Your trait gives you a goal, scored at the end. Nobody else was offered these, and rivals never learn which
            you chose until the match ends: they can only guess. The map is revealed once you have chosen.</p>
        <fieldset class="traits">
            @foreach (var offered in me.Offer)
            {
                var t = offered;
                <label class="choice">
                    <input type="radio" name="trait" checked="@(trait == t)" @onchange="() => trait = t" />
                    <span><b>@t</b>: @Capitalised(match.GoalText(t))</span>
                </label>
            }
        </fieldset>
        <div class="action-bar">
            <p class="action-sum">@(trait is { } t2 ? $"{t2}: {match.GoalText(t2)}" : "Choose one of your two traits.")</p>
            <div class="action-row">
                <button type="button" class="btn btn-primary btn-lg" disabled="@(busy || trait is null)" @onclick="ChooseTraitAsync">Choose @(trait?.ToString() ?? "a trait")</button>
            </div>
        </div>
    }
    else if (playing && match.Phase == MatchPhase.Opening)
    {
        @if (match.OpeningUnveil == 1)
        {
            <StartSteps Step="3" />
        }
        var up = match.OnAuction[0];
        <h2 class="h4">Opening auction @match.OpeningUnveil of @match.Rules.OpeningUnveils: tile @match.AuctionTile of @match.Seats.Count</h2>
        @if (match.OpeningUnveil == 1 && match.AuctionTile == 1)
        {
            <p>The map is revealed: one tile for each player, and they go up one at a time. Bid on the tile up now, or
                pass and wait for a better one. The highest bid wins it; whoever wins none gets the last tile free.</p>
        }
        @if (!match.Bidders.Contains(you))
        {
            <p class="commit-line">You have your tile from this auction. The others bid on the rest.</p>
        }
        else
        {
            <p class="tile-up">Up now: <b>@Seats.Describe(match, up, you, view.Owners, named: false)</b>.</p>
            @if (match.OnAuction.Count > 1)
            {
                <p class="text-muted">Still to come: @string.Join(", ", match.OnAuction.Skip(1).Select(h => $"{Seats.Mark(match.Map[h].Type)} {match.Map[h].Type}")).
                    @(match.OnAuction.Count == 2 ? "Lose this one and it's yours, free." : "The last one goes free to whoever wins none.")</p>
            }

            <label class="form-label mt-2" for="amount">Your bid (mana)</label>
            <input id="amount" type="number" class="form-control form-control-lg" min="@match.Rules.MinBid" max="@me.Mana" @bind="amount" @bind:event="oninput" />

            var check = match.CheckBid(new Bid(you, up, amount));
            <div class="ledger mt-2">
                @foreach (var line in check.Lines)
                {
                    <p class="@(check.Succeeded ? "ledger-line" : "ledger-problem")">@TileNames.In(match.Map, line, named)</p>
                }
            </div>

            <div class="action-bar">
                <p class="action-sum @(check is { Succeeded: false } ? "ledger-problem" : "")">@TileNames.In(match.Map, check.Lines[0], named)</p>
                <div class="action-row">
                    <button type="button" class="btn btn-outline-primary btn-lg" disabled="@busy" @onclick="PassAsync">Pass</button>
                    <button type="button" class="btn btn-primary btn-lg" disabled="@(busy || !check.Succeeded)" @onclick="BidAsync">Bid @amount mana</button>
                </div>
            </div>
        }
    }
    else if (playing && match.Phase == MatchPhase.Rounds)
    {
        <OrdersForm Match="match" You="you" Owners="view.Owners" Selected="selected" OnSelect="Select" OnCommit="CommitAsync" Busy="busy" />
    }
    else if (match.Phase == MatchPhase.Ended)
    {
        <h2 class="h4">The match is over</h2>
        <p>After @match.Rules.Rounds rounds, the most points wins; ties go to the most tiles, then the most mana.</p>
    }
    </section>
    }

    @{ var lastReport = view.LastReportFor(you); }
    @if (lastReport.Count > 0 && replay is null)
    {
        <section id="report">
        <h2 class="h4 mt-4">What just happened</h2>
        <div class="match-report">
            @{
                var verdicts = Verdicts.Find(lastReport, you);
                var yours = Verdicts.Yours(lastReport, you);
                var hidden = lastReport.Count - yours.Count;
            }
            @for (var i = 0; i < lastReport.Count; i++)
            {
                @if (fullReport || yours.Contains(i))
                {
                    <p>@Seats.Phrase(TileNames.In(match.Map, lastReport[i], named), view.Owners, you)</p>
                    @if (verdicts.TryGetValue(i, out var verdict))
                    {
                        <p class="stamp-line"><span class="stamp @(verdict.Won ? "stamp-victory" : "stamp-defeat")">@verdict.Text</span></p>
                    }
                }
            }
        </div>
        @if (hidden > 0)
        {
            <button type="button" class="btn btn-link report-toggle" @onclick="() => fullReport = !fullReport">
                @(fullReport ? "Only what concerns you" : $"Everything that happened ({hidden} more {(hidden == 1 ? "line" : "lines")})")
            </button>
        }
        </section>
    }

    @if (playing && view.HostId == ownerId && view.InStep.Any(p => p != you && !view.Committed.Contains(p)))
    {
        <section id="host">
        <h2 class="h4">You are the host</h2>
        @if (handOff is { } seat)
        {
            <p class="ledger-line">A bot plays seat @(seat + 1) for the rest of the match; its player can still watch, but
                can't take it back. If everyone else has committed, the step resolves now.</p>
            <div class="d-grid gap-2">
                <button type="button" class="btn btn-outline-primary btn-lg" disabled="@busy" @onclick="() => handOff = null">Keep them</button>
                <button type="button" class="btn btn-primary btn-lg" disabled="@busy" @onclick="HandToBotAsync">Hand seat @(seat + 1) to a bot</button>
            </div>
        }
        else
        {
            <p>If a player has gone quiet, you can hand their seat to a bot instead of waiting for the deadline. Only
                players who haven't committed this step are listed.</p>
            @foreach (var person in view.InStep.Where(p => p != you && !view.Committed.Contains(p)))
            {
                var p = person;
                <button type="button" class="btn btn-outline-primary btn-lg w-100 mb-2" disabled="@busy" @onclick="() => handOff = p">
                    Seat @(p + 1)@(view.Missed.GetValueOrDefault(p) > 0 ? ", missed the last deadline" : ""): hand to a bot…
                </button>
            }
        }
        </section>
    }

    @* Nobody scores in the opening, so the standings wait for the rounds. *@
    @if (match.Phase != MatchPhase.Opening)
    {
    <section id="standings">
    <button type="button" class="fold-head mt-4" aria-expanded="@showStandings" @onclick="() => showStandings = !showStandings">
        <span class="fold-title">Standings @(showStandings ? "▾" : "▸")</span>
        <span class="fold-sum">@Leaders(match)</span>
    </button>
    @if (showStandings)
    {
    <div class="fold-body">
    <table class="table standings">
        <thead><tr><th>Seat</th><th>Points</th><th>Tiles</th><th>Mana</th></tr></thead>
        <tbody>
            @foreach (var seat in match.Standings)
            {
                <tr class="@(seat.Index == you ? "you" : "")">
                    <td><span class="seat-ink" style="--seat: @Seats.Ink(seat.Index)">@Seats.Name(view, seat.Index, you)</span></td>
                    <td>@seat.Score</td>
                    <td>@seat.Tiles.Count</td>
                    <td>@(match.ManaSeenBy(you, seat.Index)?.ToString() ?? "?")</td>
                </tr>
            }
        </tbody>
    </table>
    @if (match.Phase == MatchPhase.Ended && match.Seats.Any(s => s.Index != you && s.Trait is not null))
    {
        <p class="trait-line">Rivals' traits: @string.Join(", ", match.Seats.Where(s => s.Index != you && s.Trait is not null)
            .Select(s => $"{Seats.Name(view, s.Index, you)} had {s.Trait}")).</p>
    }
    else if (match.Phase == MatchPhase.Rounds && match.Seats.Any(s => s.Index != you && s.Trait is not null))
    {
        <p class="trait-line">Rivals' traits are secret until the end.
            @(me.Guesses.Count == 0 ? "You haven't guessed any yet."
                : "Your guesses: " + string.Join(", ", me.Guesses.OrderBy(g => g.Key).Select(g => $"{Seats.Name(view, g.Key, you)}: {g.Value}")) + ".")</p>
    }
    @if (match.Phase == MatchPhase.Ended && match.Winners.Count > 0)
    {
        <p><b>@string.Join(" and ", match.Winners.Select(w => Seats.Name(view, w.Index, you))) @(match.Winners.Count == 1 && match.Winners[0].Index != you ? "wins" : "win").</b></p>
    }
    </div>
    }
    </section>
    }
    <p><a href="">Back home</a></p>
    </div>

    @if (!drafting)
    {
    <nav class="match-tabs" aria-label="Match">
        <a href="match/@Id#map">Map</a>
        <a href="match/@Id#orders">@(match.Phase == MatchPhase.Ended ? "End" : "Orders")</a>
        <a href="match/@Id#report">Report</a>
        @if (match.Phase != MatchPhase.Opening)
        {
            <button type="button" @onclick="OpenStandings">Standings</button>
        }
    </nav>
    }
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string ownerId = string.Empty;
    private LoadedMatch? view;
    private int you;
    private IReadOnlySet<Hex> auction = new HashSet<Hex>();
    private Hex? selected;
    private int amount = 1;
    private string? bidStep;
    private Trait? trait;
    private bool fullReport;
    private string? status;
    private bool loading = true;
    private bool busy;
    private int? handOff;
    private bool welcomed;
    private bool showStandings;
    private bool scrollToStandings;
    private int? seenRound;
    private string? seenReport;
    private IReadOnlyList<string>? replay;
    private int replayBeat;
    private CancellationTokenSource? replayStop;
    /// <summary>The pause between the playback's lines: Match:ReplayDelayMs in configuration, 1.5 s by default.</summary>
    private TimeSpan ReplayDelay => TimeSpan.FromMilliseconds(Config.GetValue("Match:ReplayDelayMs", 1500));
    private int? newRound;

    protected override async Task OnParametersSetAsync()
    {
        ownerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        view = await Play.ViewAsync(Id, ownerId);
        var report = string.Join('\n', view?.LastReport ?? []);
        if (seenReport is not null && report != seenReport && view is not null)
        {
            StartReplay(view.LastReportFor(you));
        }

        seenReport = report;
        if (seenRound is { } seen && view?.Match.CurrentRound > seen)
        {
            newRound = view.Match.CurrentRound; // it began while the page was open
        }

        seenRound = view?.Match.CurrentRound;
        showStandings |= view?.Match.Phase == MatchPhase.Ended; // the payoff of an ended match
        you = view?.SeatOf(ownerId) ?? 0;
        auction = view?.Match.OnAuction.Take(1).ToHashSet() ?? []; // the tile up now
        if (selected is { } s && view?.Match.Map.Contains(s) != true)
        {
            selected = null;
        }

        if (view is not null && MatchStore.StepKey(view.Match) != bidStep)
        {
            bidStep = MatchStore.StepKey(view.Match);
            amount = view.Match.Rules.MinBid; // a new tile starts from the smallest bid, not the last one
        }

        amount = Math.Clamp(amount, view?.Match.Rules.MinBid ?? 1, Math.Max(1, view?.Match.Seats[you].Mana ?? 1));
    }

    private void Select(Hex hex) => selected = hex;

    /// <summary>
    /// Plays an auction's report back a line at a time, <see cref="ReplayDelay"/> apart: each tile's bids, then who got
    /// it, with the tile marked and its owner's ring only appearing then. Only the auction's lines play; whatever
    /// follows (the rounds beginning) shows once it is done. Skip ends it at once.
    /// </summary>
    private void StartReplay(IReadOnlyList<string> report)
    {
        var beats = report.TakeWhile(IsAuctionLine).ToList();
        if (beats.Count == 0)
        {
            return;
        }

        replayStop?.Cancel();
        replayStop = new CancellationTokenSource();
        replay = beats;
        replayBeat = 1;
        _ = ReplayAsync(replayStop.Token);
    }

    private static bool IsAuctionLine(string line) =>
        line.StartsWith("Bids on ", StringComparison.Ordinal) || line.StartsWith("A tie for ", StringComparison.Ordinal)
        || line.StartsWith("Nobody bids on ", StringComparison.Ordinal) || System.Text.RegularExpressions.Regex.IsMatch(line, @"^Seat \d+ (wins|gets) ");

    private static bool Hands(string line) => System.Text.RegularExpressions.Regex.IsMatch(line, @"^(Seat \d+ (wins|gets) |Nobody bids on )");

    private async Task ReplayAsync(CancellationToken stop)
    {
        try
        {
            while (replay is { } beats && replayBeat < beats.Count)
            {
                await Task.Delay(ReplayDelay, stop);
                await InvokeAsync(() =>
                {
                    replayBeat++;
                    StateHasChanged();
                });
            }

            await Task.Delay(ReplayDelay, stop);
            await InvokeAsync(() =>
            {
                replay = null;
                StateHasChanged();
            });
        }
        catch (TaskCanceledException)
        {
            // skipped, or the page closed
        }
    }

    private void SkipReplay()
    {
        replayStop?.Cancel();
        replay = null;
    }

    /// <summary>The tile the playback is on, marked on the map.</summary>
    private Hex? ReplayTile => replay is { } beats && replayBeat > 0 ? TileNames.Of(beats[replayBeat - 1]).Cast<Hex?>().FirstOrDefault() : null;

    /// <summary>The tiles the playback hasn't handed out yet, shown without their new owner until it does.</summary>
    private IReadOnlySet<Hex>? ReplayPending => replay is { } beats
        ? beats.Skip(replayBeat).Where(Hands).SelectMany(l => TileNames.Of(l).Take(1)).ToHashSet()
        : null;

    public void Dispose() => replayStop?.Cancel();

    /// <summary>The bottom tab: opens the standings, then (once they are on the page) scrolls to them.</summary>
    private void OpenStandings()
    {
        showStandings = true;
        scrollToStandings = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (scrollToStandings)
        {
            scrollToStandings = false;
            Nav.NavigateTo($"match/{Id}#standings");
        }
    }

    /// <summary>Who leads on points, for the folded standings: "Bot 3 leads, 4 points" (at the end, "wins").</summary>
    private string Leaders(Match match)
    {
        var top = match.Seats.Max(s => s.Score);
        if (top == 0)
        {
            return "nobody has points yet";
        }

        var leaders = match.Seats.Where(s => s.Score == top).Select(s => Seats.Name(view!, s.Index, you)).ToList();
        var points = $"{top} {(top == 1 ? "point" : "points")}";
        if (leaders.Count > 2)
        {
            return $"{leaders.Count} tied, {points}";
        }

        var name = string.Join(" and ", leaders);
        var verb = match.Phase == MatchPhase.Ended ? "win" : "lead";
        return $"{name} {verb}{(leaders.Count == 1 && name != "You" ? "s" : "")}, {points}";
    }

    private Task BidAsync() => ActAsync(() => Play.BidAsync(Id, ownerId, view?.Match.OnAuction.FirstOrDefault(), amount));

    private Task CommitAsync(Orders orders) => ActAsync(() => Play.OrdersAsync(Id, ownerId, orders));

    private static string Capitalised(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    private Task ChooseTraitAsync() => trait is { } t ? ActAsync(() => Play.TraitAsync(Id, ownerId, t)) : Task.CompletedTask;

    private async Task HandToBotAsync()
    {
        if (handOff is { } seat)
        {
            await ActAsync(() => Play.HandToBotAsync(Id, ownerId, seat));
            handOff = null;
            status ??= $"A bot plays seat {seat + 1} from now on.";
        }
    }

    /// <summary>How long until a deadline, in hours and minutes.</summary>
    private string Until(DateTimeOffset due)
    {
        var left = due - Time.GetUtcNow();
        return left <= TimeSpan.Zero ? "a moment"
            : left.TotalHours >= 1 ? $"{(int)left.TotalHours} h {left.Minutes} min"
            : $"{Math.Max(1, left.Minutes)} min";
    }

    private Task WithdrawAsync() => ActAsync(async () => await Play.WithdrawAsync(Id, ownerId)
        ? new Report(true, ["Taken back."])
        : Report.Fail("The step has already resolved."));

    private Task PassAsync() => ActAsync(() => Play.BidAsync(Id, ownerId, null, 0));

    private async Task ActAsync(Func<Task<Report>> action)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var report = await action();
            status = report.Succeeded ? null : view is null ? report.Lines[0] : TileNames.In(view.Match.Map, report.Lines[0], view.Match.Phase != MatchPhase.Opening);
            selected = null;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
