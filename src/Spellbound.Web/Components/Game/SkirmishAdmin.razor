@using Spellbound.Web.Hosting
@inject SkirmishService Skirmishes
@inject AccountService Accounts

@* Shown on the admin page (registered in Program.cs as an admin section). Until players can create and join games
   themselves (roadmap M5, part 2), the admin starts Skirmish games for them. *@
<h2 class="h4 mt-4">Start a Skirmish</h2>
<p class="text-muted">
    One email per line, 2–6 players, in seat order; each needs to have signed in once. Players use their Realm mage's
    name and school this round, if they have one. The game starts at once with the default Skirmish rules.
</p>
<form class="mb-3" @onsubmit="StartAsync">
    <label class="form-label" for="skirmish-emails">Players' emails</label>
    <textarea id="skirmish-emails" class="form-control" rows="4" autocomplete="off" @bind="emails" @bind:event="oninput"></textarea>
    <label class="form-label mt-2" for="skirmish-round">Minutes per round</label>
    <input id="skirmish-round" type="number" inputmode="numeric" min="1" class="form-control" @bind="minutes" />
    <button type="submit" class="btn btn-outline-primary btn-lg w-100 mt-2" disabled="@(busy || string.IsNullOrWhiteSpace(emails))">Start the game</button>
</form>
@if (result is not null)
{
    <p role="status">@result</p>
}

@code {
    private string emails = string.Empty;
    private int minutes = 720;
    private bool busy;
    private string? result;

    private async Task StartAsync()
    {
        busy = true;
        var (gameId, problem) = await Skirmishes.CreateForEmailsAsync(emails.Split('\n'), TimeSpan.FromMinutes(minutes), Accounts);
        result = problem ?? $"Started Skirmish game {gameId}. The players see it on their Games page.";
        if (problem is null)
        {
            emails = string.Empty;
        }

        busy = false;
    }
}
