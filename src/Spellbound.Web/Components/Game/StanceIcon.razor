@* A stance's icon, a small inline SVG in the text's colour (Channel in mana blue). *@
<svg class="stance-icon" viewBox="0 0 32 32" aria-hidden="true">
    @switch (Stance)
    {
        case Stance.Attack:
            <path d="M5 27 L19 13 M27 27 L13 13 M19 13 L25 5 L27 7 Z M13 13 L7 5 L5 7 Z" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" />
            break;
        case Stance.Attune:
            <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="2" fill="none" />
            <path d="M16 6 V26 M6 16 H26" stroke="currentColor" stroke-width="1.6" />
            <circle cx="16" cy="16" r="3.5" fill="currentColor" />
            break;
        case Stance.Summon:
            <path d="M16 5 C11 5 9 10 10 14 C6 15 5 20 8 23 H24 C27 20 26 15 22 14 C23 10 21 5 16 5 Z" fill="currentColor" />
            <circle cx="13.5" cy="13" r="1.4" fill="#000" />
            <circle cx="18.5" cy="13" r="1.4" fill="#000" />
            break;
        case Stance.Build:
            <path d="M8 27 V12 H11 V8 H14 V12 H18 V8 H21 V12 H24 V27 Z" fill="currentColor" />
            <path d="M14 27 V20 H18 V27" fill="#000" />
            break;
        case Stance.Cast:
            <path d="M16 3 L19 13 L29 16 L19 19 L16 29 L13 19 L3 16 L13 13 Z" fill="currentColor" />
            break;
        default:
            <path d="M16 3 L25 12 L19 29 H13 L7 12 Z" fill="#7fb2d6" />
            <path d="M16 3 L19 12 L16 29 L13 12 Z" fill="#b8daf0" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public Stance Stance { get; set; }
}
