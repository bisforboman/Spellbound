@page "/army"
@inherits GamePage

<PageTitle>Army</PageTitle>
<h1>Army</h1>

@if (Mage is not null)
{
    <TurnsBar Mage="Mage" Rules="Rules" />

    <table class="table stats">
        <tbody>
            @foreach (var unit in UnitBook.All)
            {
                <tr><th>@unit.Name</th><td>@N(Mage.UnitCount(unit.Id))</td></tr>
            }
            <tr><th>Attack power</th><td>@N(Mage.AttackPower)</td></tr>
            <tr><th>Defense</th><td>@N(Mage.DefensePower(Rules)) (@N(Mage.Land * Rules.BaseDefensePerAcre) from your land's guards)</td></tr>
            <tr><th>Upkeep</th><td>@N(Mage.UpkeepPerTurn) gold per turn</td></tr>
        </tbody>
    </table>
    <p class="text-muted">Upkeep is paid each turn you spend. If you run out of gold, @Rules.DesertionPercent% of every unit deserts that turn.</p>

    <h2 class="h4">Recruit</h2>
    <p>You have @N(Mage.Gold) gold.</p>
    <form @onsubmit="() => RunAsync(() => Game.RecruitAsync(OwnerId, unitId, count))">
        <fieldset class="mb-3">
            <legend class="form-label">Unit</legend>
            @foreach (var unit in UnitBook.All)
            {
                <label class="choice">
                    <input type="radio" name="unit" checked="@(unitId == unit.Id)" @onchange="() => unitId = unit.Id" />
                    <span><b>@unit.Name</b>: attack @unit.Attack, defense @unit.Defense. @N(unit.GoldCost) gold each, upkeep @unit.GoldUpkeep gold per turn. @unit.Description</span>
                </label>
            }
        </fieldset>

        <label class="form-label" for="count">How many</label>
        <input id="count" type="number" inputmode="numeric" class="form-control form-control-lg" min="1" @bind="count" @bind:event="oninput" />
        <p class="cost">
            Cost: <b>@Turns(Mage.RecruitTurnCost(count, Rules))</b> and <b>@N(count * Unit.GoldCost) gold</b>.
            Upkeep goes up by @N(count * Unit.GoldUpkeep) gold per turn.
        </p>
        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@Busy">Recruit</button>
    </form>

    <ReportView Report="Report" />
}

@code {
    private string unitId = UnitBook.All[0].Id;
    private int count = 50;

    private UnitDefinition Unit => UnitBook.Find(unitId) ?? UnitBook.All[0];
}
