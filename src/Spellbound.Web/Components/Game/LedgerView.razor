@using System.Globalization
@* The ledger preview (Mage.Preview): what an action would leave you with, worked out before you confirm. *@
<div class="ledger" aria-live="polite">
    @if (!Of.Report.Succeeded)
    {
        <p class="ledger-problem">@Of.Report.Lines[0]</p>
    }
    else
    {
        <p class="ledger-line"><span class="ledger-label">After</span> @string.Join(", ", Changes())</p>
        @foreach (var warning in Of.Report.Warnings)
        {
            <p class="ledger-warning">@warning</p>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Ledger Of { get; set; } = default!;

    private IEnumerable<string> Changes()
    {
        var (before, after) = (Of.Before, Of.After);
        (string Unit, int Before, int After)[] rows =
        [
            ("acres", before.Land, after.Land),
            ("towns", before.Towns, after.Towns),
            ("nodes", before.Nodes, after.Nodes),
            ("gold", before.Gold, after.Gold),
            ("mana", before.Mana, after.Mana),
            ("units", before.Units, after.Units),
            ("gold upkeep per turn", before.UpkeepPerTurn, after.UpkeepPerTurn),
        ];
        var changed = rows.Where(r => r.Before != r.After).Select(r => $"{N(r.After)} {r.Unit} ({Delta(r.After - r.Before)})").ToList();
        return changed.Count > 0 ? changed : ["nothing changes"];
    }

    private static string Delta(int change) => (change > 0 ? "+" : "−") + N(Math.Abs(change));

    private static string N(int value) => value.ToString("N0", CultureInfo.InvariantCulture);
}
