@using Spellbound.Domain.Skirmish

@* The switches a Skirmish runs under, as a short table: on the lobby page before joining, and on the game page. *@
<table class="table table-sm stats">
    <tbody>
        <tr><th>Players</th><td>@Rules.Players</td></tr>
        <tr><th>Rounds</th><td>@Rules.Rounds, or until someone holds @((int)Math.Round(Rules.BoardShareToWin * 100))% of the board</td></tr>
        <tr><th>Round time</th><td>@Describe(RoundLength), or until everyone is ready</td></tr>
        <tr><th>Actions</th><td>@Rules.ActionsPerRound a round</td></tr>
        <tr><th>Attacks</th><td>@OnOff(Rules.Attacks)</td></tr>
        <tr><th>Hexes</th><td>@OnOff(Rules.Hexes)</td></tr>
        <tr><th>Discoveries</th><td>@OnOff(Rules.Discoveries)</td></tr>
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public SkirmishRules Rules { get; set; } = default!;

    [Parameter, EditorRequired]
    public TimeSpan RoundLength { get; set; }

    private static string OnOff(bool on) => on ? "On" : "Off";

    /// <summary>A round length in its largest whole unit: "2 minutes", "12 hours", "1 day".</summary>
    public static string Describe(TimeSpan length) =>
        length.TotalDays >= 1 && length.TotalDays % 1 == 0 ? Plural((int)length.TotalDays, "day")
        : length.TotalHours >= 1 && length.TotalHours % 1 == 0 ? Plural((int)length.TotalHours, "hour")
        : Plural((int)Math.Round(length.TotalMinutes), "minute");

    private static string Plural(int count, string unit) => $"{count} {unit}{(count == 1 ? "" : "s")}";
}
