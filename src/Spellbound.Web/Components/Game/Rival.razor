@page "/rivals/{Id:guid}"
@inherits GamePage

<PageTitle>@(rival?.Name ?? "Rival")</PageTitle>

@if (Mage is not null && rival is null)
{
    <h1>Rival</h1>
    <p>There is no such mage. <a href="rivals">Back to Rivals</a>.</p>
}
else if (Mage is not null && rival is not null)
{
    var problem = Mage.TargetProblem(rival, Rules);
    var counter = Mage.CounterSign(rival);

    <h1>@rival.Name</h1>
    <p class="text-muted">@rival.School mage</p>

    <TurnsBar Mage="Mage" />

    <table class="table stats">
        <tbody>
            <tr><th>Land</th><td>@N(rival.Land) acres</td></tr>
            <tr><th>Networth</th><td>@N(rival.Networth(Rules))</td></tr>
            <tr><th>Status</th><td>@(rival.IsProtected(Rules) ? "Protected" : "Open to attack")</td></tr>
        </tbody>
    </table>

    @if (counter != 0)
    {
        <p>
            @(counter > 0 ? $"Your {Mage.School} magic has the edge over their {rival.School} magic" : $"Their {rival.School} magic has the edge over your {Mage.School} magic"):
            @(counter > 0 ? "+" : "−")@((int)(Rules.CounterBonus * 100))% attack power and @(counter > 0 ? "+" : "−")@((int)(Rules.HexCounterBonus * 100)) points of hex chance.
        </p>
    }

    @if (problem is not null)
    {
        <p class="alert alert-secondary">@problem</p>
    }

    <h2 class="h4">Attack</h2>
    <p>
        Your attack power is <b>@N(Mage.AttackPower)</b>. Their army is unknown; their land's guards alone give
        @N(rival.Land * Rules.BaseDefensePerAcre) defense. Luck moves both sides by up to @((int)(Rules.CombatRollSpread * 100))%.
        A win takes @Rules.LandTakenPercent% of their land.
    </p>
    <p class="cost">Cost: <b>@Turns(Rules.AttackTurnCost)</b>. You lose @Rules.AttackerLossPercentOnWin% of your units if you win, @Rules.AttackerLossPercentOnLoss% if you lose.</p>
    <button type="button" class="btn btn-danger btn-lg w-100" disabled="@(Busy || problem is not null || Mage.AttackPower == 0)"
            @onclick="() => RunAsync(() => Game.AttackAsync(OwnerId, rival.Id))">
        Attack @rival.Name
    </button>
    @if (Mage.AttackPower == 0)
    {
        <p class="text-muted mt-2">You have no army. <a href="army">Recruit one</a>.</p>
    }

    @foreach (var hex in SpellBook.HexesForSchool(Mage.School))
    {
        <h2 class="h4 mt-4">Hex: @hex.Name</h2>
        <p>@hex.Description</p>
        <p>Chance to land: <b>@((int)Math.Round(Mage.HexChance(rival, Rules) * 100))%</b>, less if they have a Barrier up.</p>
        <p class="cost">Cost: <b>@N(hex.ManaCost) mana</b> and <b>@Turns(hex.TurnCost)</b>. You have @N(Mage.Mana) mana.</p>
        <button type="button" class="btn btn-danger btn-lg w-100" disabled="@(Busy || problem is not null)"
                @onclick="() => RunAsync(() => Game.HexAsync(OwnerId, hex.Id, rival.Id))">
            Cast @hex.Name
        </button>
    }

    <ReportView Report="Report" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Mage? rival;

    protected override async Task LoadAsync()
    {
        await base.LoadAsync();
        rival = await Game.GetRivalAsync(Id);
    }
}
