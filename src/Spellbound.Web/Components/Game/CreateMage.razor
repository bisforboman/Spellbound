@page "/create"
@using System.Security.Claims
@inject GameService Game
@inject NavigationManager Navigation

<PageTitle>Create your mage</PageTitle>
<h1>Create your mage</h1>
<RoundInfo Round="round" />
<p>Everyone starts equal each round. When it ends, the top mages go into the hall of fame and the world resets.</p>

<form @onsubmit="CreateAsync">
    <label class="form-label" for="name">Name</label>
    <input id="name" class="form-control form-control-lg mb-3" maxlength="@Mage.MaxNameLength" autocomplete="off" @bind="name" />

    <fieldset class="mb-3">
        <legend class="form-label">School of magic</legend>
        @foreach (var school in Enum.GetValues<MagicSchool>())
        {
            var spell = SpellBook.ForSchool(school).First();
            <label class="choice">
                <input type="radio" name="school" checked="@(selected == school)" @onchange="() => selected = school" />
                <span>
                    <b>@school.DisplayName()</b>: @spell.Name. @spell.Description<br />
                    <small class="text-muted">Strong against @school.StrongAgainst().DisplayName(), weak against @school.WeakAgainst().DisplayName().</small>
                </span>
            </label>
        }
    </fieldset>

    <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@busy">Begin</button>
</form>

<ReportView Report="report" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string ownerId = string.Empty;
    private string name = string.Empty;
    private MagicSchool selected = MagicSchool.Dawn;
    private ActionReport? report;
    private bool busy;
    private Round? round;

    protected override async Task OnInitializedAsync()
    {
        ownerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        round = await Game.GetRoundAsync();
        if (await Game.GetMageAsync(ownerId) is not null)
        {
            Navigation.NavigateTo("realm");
        }
    }

    private async Task CreateAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        report = await Game.CreateMageAsync(ownerId, name, selected);
        busy = false;
        if (report.Succeeded)
        {
            Navigation.NavigateTo("realm");
        }
    }
}
