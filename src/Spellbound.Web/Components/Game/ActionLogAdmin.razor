@using System.Globalization
@using Spellbound.Web.Data
@inject GameService Game

@* Shown on the admin page (registered in Program.cs as an admin section). *@
<h2 class="h4 mt-4">Action log</h2>
<p class="text-muted">
    Every successful action this round, with what the player chose and what happened, for settling disputes. Attacks
    and hexes against the mage are included. The full log, with the random numbers and the mage's numbers after each
    action, is in the <code>actions</code> table (see docs/deploy.md).
</p>
<form class="mb-3" @onsubmit="LookUpAsync">
    <label class="form-label" for="log-mage">Mage name</label>
    <input id="log-mage" class="form-control" autocomplete="off" @bind="mageName" @bind:event="oninput" />
    <button type="submit" class="btn btn-outline-primary w-100 mt-2" disabled="@(busy || string.IsNullOrWhiteSpace(mageName))">Show actions</button>
</form>

@if (searched is not null)
{
    if (mage is null)
    {
        <p class="text-muted">No mage called "@searched" this round.</p>
    }
    else if (actions.Count == 0)
    {
        <p class="text-muted">@mage.Name hasn't done anything yet.</p>
    }
    else
    {
        <p><b>@mage.Name</b> (@mage.School.DisplayName()), latest @actions.Count:</p>
        @foreach (var action in actions)
        {
            <div class="admin-player">
                <small class="text-muted d-block">
                    @action.At.UtcDateTime.ToString("d MMM HH:mm:ss", CultureInfo.InvariantCulture) UTC ·
                    @(action.Against ? $"{action.Action} against them" : action.Action)
                    · <code>@action.Inputs</code>
                </small>
                @foreach (var line in action.Lines.Take(3))
                {
                    <div>@line</div>
                }
            </div>
        }
    }
}

@code {
    private string mageName = string.Empty;
    private string? searched;
    private Mage? mage;
    private IReadOnlyList<LoggedAction> actions = [];
    private bool busy;

    private async Task LookUpAsync()
    {
        busy = true;
        try
        {
            searched = mageName.Trim();
            (mage, actions) = await Game.GetActionLogAsync(searched);
        }
        finally
        {
            busy = false;
        }
    }
}
