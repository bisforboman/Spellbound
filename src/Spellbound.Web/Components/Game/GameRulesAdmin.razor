@using System.Globalization
@inject GameService Game
@inject GameRules Configured

@* Shown on the admin page (registered in Program.cs as an admin section). *@
<h2 class="h4 mt-4">Game rules</h2>
<p class="text-muted">
    The current round's rules: a round keeps the rules it started with. The configured ones (the <code>GameRules</code>
    section of <code>appsettings.json</code>, or environment variables such as <code>GameRules__MaxTurns</code>, applied
    when the app restarts) are used from the next round on; where they differ, they're shown in brackets. Unit and spell
    stats are in the code.
</p>
@if (rules is not null)
{
    <table class="table table-sm stats">
        <tbody>
            @foreach (var property in typeof(GameRules).GetProperties().Where(p => p.GetMethod?.IsStatic == false))
            {
                var now = Format(property.GetValue(rules));
                var next = Format(property.GetValue(Configured));
                <tr><th>@property.Name</th><td>@now@(next != now ? $" (next round: {next})" : null)</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private GameRules? rules;

    protected override async Task OnInitializedAsync() => rules = (await Game.GetRealmAsync())?.Rules ?? Configured;

    private static string Format(object? value) => value switch
    {
        int i => i.ToString("N0", CultureInfo.InvariantCulture),
        double d => d.ToString(CultureInfo.InvariantCulture),
        TimeSpan t => t.ToString("c", CultureInfo.InvariantCulture),
        _ => value?.ToString() ?? string.Empty,
    };
}
