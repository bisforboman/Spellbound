@page "/explore"
@inherits GamePage

<PageTitle>Explore</PageTitle>
<h1>Explore</h1>

@if (Mage is not null && conditions is not null)
{
    <TurnsBar Mage="Mage" Rules="Rules" />
    <p>
        You hold @N(Mage.Land) acres. Each turn of exploring finds about <b>@Mage.ExploreYield(Rules, conditions).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)</b>
        acres, fewer as your land grows.
        @if (conditions.Phase >= SeasonPhase.Contest)
        {
            <text> It is the @conditions.Phase: land now comes mainly from war, and exploring finds @Percent(Rules.ExploreLateMultiplier) as much.</text>
        }
        @if (Mage.Land < conditions.MedianLand)
        {
            <text> You hold less than the median mage (@N(conditions.MedianLand) acres), so it finds @Percent(Rules.ExploreBelowMedianMultiplier) as much until you catch up.</text>
        }
    </p>

    <form @onsubmit="() => RunAsync(() => Game.ExploreAsync(OwnerId, turns))">
        <label class="form-label" for="turns">Turns to spend</label>
        <input id="turns" type="number" inputmode="numeric" class="form-control form-control-lg" min="1" max="@Mage.Turns" @bind="turns" @bind:event="oninput" />
        <p class="cost">Cost: <b>@Turns(turns)</b></p>
        <LedgerView Of="Mage.Preview(Game.Now, Rules, m => m.Explore(turns, Game.Now, Rules, conditions))" />
        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@Busy">Explore</button>
    </form>

    <ReportView Report="Report" />
}

@code {
    private int turns = 10;
    private ExploreConditions? conditions;

    protected override async Task LoadAsync()
    {
        await base.LoadAsync();
        conditions = await Game.GetExploreConditionsAsync();
    }

    private static string Percent(double share) => (share * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
