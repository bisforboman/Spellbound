@if (Report is not null)
{
    <div class="alert @(Report.Succeeded ? "alert-success" : "alert-danger") mt-3" role="status">
        @if (Report.Won is { } won)
        {
            @* A battle's verdict, branded onto the report *@
            <p class="stamp-line"><span class="stamp @(won ? "stamp-victory" : "stamp-defeat")">@(won ? "Conquered" : "Repelled")</span></p>
        }
        @foreach (var line in Report.Lines)
        {
            <p class="mb-1">@line</p>
        }
    </div>
}

@code {
    [Parameter]
    public ActionReport? Report { get; set; }
}
