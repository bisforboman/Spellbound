@* Mana: a crystal shard, its right face in shadow, after the number it counts ("9 ◆"); screen readers hear "9 mana".
   In cold blue (docs/theme.md, "The mana icon"). *@
<svg class="mana-icon" viewBox="0 0 24 24" width="@Size" height="@Size" fill="currentColor" role="img" aria-label="mana">
    <title>mana</title>
    <path d="M12 1.5 6 8.5 8.6 19.8 12 22.5z" />
    <path opacity=".5" d="M12 1.5 18 8.5 15.4 19.8 12 22.5z" />
</svg>

@code {
    /// <summary>The icon's width and height: 1em follows the text it sits in; the map passes its own units.</summary>
    [Parameter]
    public string Size { get; set; } = "1em";
}
