@page "/rivals"
@inherits GamePage

<PageTitle>Rivals</PageTitle>
<h1>Rivals</h1>
<RoundInfo Round="Round" />
<p>Every attack and hex this round is told in <a href="chronicle">the Chronicle</a>.</p>

@if (Mage is not null)
{
    <div class="btn-group w-100 mb-3" role="group" aria-label="Rank by">
        <button type="button" class="btn @(byNetworth ? "btn-outline-primary" : "btn-primary")" @onclick="() => byNetworth = false">By land</button>
        <button type="button" class="btn @(byNetworth ? "btn-primary" : "btn-outline-primary")" @onclick="() => byNetworth = true">By net power</button>
    </div>
    <p class="text-muted">Net power counts @Mage.NetPowerFormula(Rules)</p>

    <ol class="rank-list">
        @foreach (var (rival, rank) in Ranked().Select((m, i) => (m, i + 1)))
        {
            var you = rival.Id == Mage.Id;
            <li>
                <a class="rank-row @(you ? "you" : null)" href="@(you ? "realm" : $"rivals/{rival.Id}")">
                    <span class="rank">@rank</span>
                    <span class="who">
                        <b>@rival.Name</b>
                        <small class="text-muted d-block">
                            @rival.School.DisplayName()@(you ? " · you" : null)@(rival.IsProtected(Game.Now, Rules) ? " · protected" : null)@(!you && !Mage.InRange(rival, Rules) ? " · out of range" : null)
                        </small>
                    </span>
                    <span class="num">@N(byNetworth ? rival.Networth(Rules) : rival.Land)<small class="text-muted d-block">@(byNetworth ? "net power" : "acres")</small></span>
                </a>
            </li>
        }
    </ol>
}

@code {
    private IReadOnlyList<Mage> mages = [];
    private bool byNetworth;

    protected override async Task LoadAsync()
    {
        await base.LoadAsync();
        mages = await Game.GetAllMagesAsync();
    }

    private IEnumerable<Mage> Ranked() => byNetworth ? Rankings.ByNetworth(mages, Rules) : Rankings.ByLand(mages);
}
