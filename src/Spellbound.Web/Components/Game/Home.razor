@page "/realm"
@using Spellbound.Web.Data
@inherits GamePage

<PageTitle>Spellbound</PageTitle>

@if (Mage is not null)
{
    <div class="mage-head">
        <Sigil Name="@Mage.Name" School="Mage.School" Size="64" />
        <div>
            <h1 class="mage-name">@Mage.Name</h1>
            <p class="text-muted">@Mage.School.DisplayName() mage</p>
        </div>
    </div>
    <RoundInfo Round="Round" Rules="Rules" />

    @if (alerts > 0)
    {
        <p class="alert alert-warning" role="alert">
            <b>You were targeted @(alerts == 1 ? "once" : $"{alerts} times") while you were away.</b> See the news below.
        </p>
    }

    @if (Mage.IsInVigil(Game.Now))
    {
        <div class="alert alert-secondary vigil-banner" role="status">
            <p class="mb-2"><b>You are keeping a Vigil</b> until @Mage.VigilEndsAt!.Value.ToString("d MMM HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC. Your realm is frozen: no turns come in, and you can neither act nor be struck.</p>
            <button type="button" class="btn btn-outline-secondary w-100" disabled="@Busy" @onclick="() => RunAsync(() => Game.EndVigilAsync(OwnerId))">End the Vigil now</button>
        </div>
    }

    <TurnsBar Mage="Mage" Rules="Rules" />
    <ManaVial Mana="Mage.Mana" Capacity="Mage.ManaCapacity(Rules)" />

    @if (Mage.IsProtected(Game.Now, Rules))
    {
        <p class="text-muted">Protected from attacks and hexes @Mage.DescribeProtection(Game.Now, Rules). While protected you can't target others either.</p>
    }

    <table class="table stats">
        <tbody>
            <tr><th><Glyph Kind="GlyphKind.Land" />Land</th><td>@N(Mage.Land) acres (@N(Mage.FreeLand) free)</td></tr>
            <tr><th>Nodes</th><td>@N(Mage.Nodes)</td></tr>
            <tr><th>Towns</th><td>@N(Mage.Towns)</td></tr>
            <tr><th><Glyph Kind="GlyphKind.Gold" />Gold</th><td>@N(Mage.Gold)</td></tr>
            <tr><th><Glyph Kind="GlyphKind.Army" />Army</th><td>@N(Mage.TotalUnits) units, @N(Mage.UpkeepPerTurn) gold upkeep per turn</td></tr>
            <tr><th>Net power</th><td>@N(Mage.Networth(Rules))</td></tr>
        </tbody>
    </table>

    <h2>Active spells</h2>
    @if (Mage.ActiveEffects.Count == 0)
    {
        <p class="text-muted">None. <a href="magic">Cast one</a>.</p>
    }
    else
    {
        <ul>
            @foreach (var effect in Mage.ActiveEffects)
            {
                <li>@(SpellBook.Find(effect.SpellId)?.Name ?? effect.SpellId): @effect.RemainingTurns turns left</li>
            }
        </ul>
    }

    <h2>Vigil</h2>
    @if (Mage.IsInVigil(Game.Now))
    {
        <p class="text-muted">Your Vigil is under way; you can end it above.</p>
    }
    else if (Mage.VigilsKept >= Rules.VigilsPerRound)
    {
        <p class="text-muted">You have kept your Vigil this round.</p>
    }
    else
    {
        <p>Going away? Once a round you can freeze your realm for up to @((int)Rules.VigilMaxDuration.TotalHours) hours: no turns come in (so none are lost at the cap), and you can neither act nor be struck. You can end it early, but it still counts.</p>
        <form @onsubmit="() => RunAsync(() => Game.StartVigilAsync(OwnerId, vigilHours))">
            <label class="form-label" for="vigil-hours">Hours</label>
            <input id="vigil-hours" type="number" inputmode="numeric" class="form-control form-control-lg" min="1" max="@((int)Rules.VigilMaxDuration.TotalHours)" @bind="vigilHours" @bind:event="oninput" />
            <p class="cost">Cost: <b>no turns</b>, but it is your one Vigil this round.</p>
            <LedgerView Of="Mage.Preview(Game.Now, Rules, m => m.StartVigil(TimeSpan.FromHours(vigilHours), Game.Now, Rules))" />
            <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@Busy">Keep a Vigil</button>
        </form>
    }
    <ReportView Report="Report" />

    <h2>News</h2>
    @if (news.Count == 0)
    {
        <p class="text-muted">Nothing has happened yet. Try <a href="explore">exploring</a>.</p>
    }
    @foreach (var entry in news)
    {
        <div class="news-entry @(entry.Hostile ? "hostile" : null)">
            <small class="text-muted">@Ago(entry.At)</small>
            @foreach (var line in entry.Lines)
            {
                <p class="mb-1">@line</p>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<NewsEntry> news = [];
    private int vigilHours = 72;
    private int alerts;
    private bool alertsTaken;

    // Taken after an interactive render, not on init: prerendering runs init twice and would reset it unseen. Not only
    // on the first render either: that one can come before the mage has loaded, and the banner would never show.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!alertsTaken && Mage is not null)
        {
            alertsTaken = true;
            alerts = await Game.TakeUnseenAlertsAsync(OwnerId);
            if (alerts > 0)
            {
                StateHasChanged();
            }
        }
    }

    protected override async Task LoadAsync()
    {
        await base.LoadAsync();
        if (Mage is not null)
        {
            news = await Game.GetNewsAsync(OwnerId);
        }
    }
}
