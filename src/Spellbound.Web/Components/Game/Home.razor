@page "/"
@using Spellbound.Web.Data
@inherits GamePage

<PageTitle>Spellbound</PageTitle>

@if (Mage is not null)
{
    <h1>@Mage.Name</h1>
    <p class="text-muted">@Mage.School mage</p>
    <RoundInfo Round="Round" />

    @if (alerts > 0)
    {
        <p class="alert alert-warning" role="alert">
            <b>You were targeted @(alerts == 1 ? "once" : $"{alerts} times") while you were away.</b> See the news below.
        </p>
    }

    <TurnsBar Mage="Mage" />

    @if (Mage.IsProtected(Rules))
    {
        <p class="text-muted">Protected from attacks and hexes for @N(Rules.ProtectionTurns - Mage.TurnsSpent) more turns. While protected you can't target others either.</p>
    }

    <table class="table stats">
        <tbody>
            <tr><th>Land</th><td>@N(Mage.Land) acres (@N(Mage.FreeLand) free)</td></tr>
            <tr><th>Nodes</th><td>@N(Mage.Nodes)</td></tr>
            <tr><th>Towns</th><td>@N(Mage.Towns)</td></tr>
            <tr><th>Gold</th><td>@N(Mage.Gold)</td></tr>
            <tr><th>Mana</th><td>@N(Mage.Mana) / @N(Mage.ManaCapacity(Rules))</td></tr>
            <tr><th>Army</th><td>@N(Mage.TotalUnits) units, @N(Mage.UpkeepPerTurn) gold upkeep per turn</td></tr>
            <tr><th>Networth</th><td>@N(Mage.Networth(Rules))</td></tr>
        </tbody>
    </table>

    <h2>Active spells</h2>
    @if (Mage.ActiveEffects.Count == 0)
    {
        <p class="text-muted">None. <a href="magic">Cast one</a>.</p>
    }
    else
    {
        <ul>
            @foreach (var effect in Mage.ActiveEffects)
            {
                <li>@(SpellBook.Find(effect.SpellId)?.Name ?? effect.SpellId): @effect.RemainingTurns turns left</li>
            }
        </ul>
    }

    <h2>News</h2>
    @if (news.Count == 0)
    {
        <p class="text-muted">Nothing has happened yet. Try <a href="explore">exploring</a>.</p>
    }
    @foreach (var entry in news)
    {
        <div class="news-entry @(entry.Hostile ? "hostile" : null)">
            <small class="text-muted">@Ago(entry.At)</small>
            @foreach (var line in entry.Lines)
            {
                <p class="mb-1">@line</p>
            }
        </div>
    }
}

@code {
    private IReadOnlyList<NewsEntry> news = [];
    private int alerts;

    // Taken after the first interactive render, not on init: prerendering runs init twice and would reset it unseen.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Mage is not null)
        {
            alerts = await Game.TakeUnseenAlertsAsync(OwnerId);
            if (alerts > 0)
            {
                StateHasChanged();
            }
        }
    }

    protected override async Task LoadAsync()
    {
        await base.LoadAsync();
        if (Mage is not null)
        {
            news = await Game.GetNewsAsync(OwnerId);
        }
    }

    private string Ago(DateTimeOffset at)
    {
        var age = Game.Now - at;
        return age.TotalMinutes < 1 ? "just now"
            : age.TotalHours < 1 ? $"{(int)age.TotalMinutes} min ago"
            : age.TotalDays < 1 ? $"{(int)age.TotalHours} h ago"
            : $"{(int)age.TotalDays} d ago";
    }
}
