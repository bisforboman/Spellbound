@using System.Globalization
@using Spellbound.Domain.Skirmish

@* Adds one order to the player's list: pick what to do, then where or what, and see its cost and odds first. *@
<fieldset class="mb-2">
    <legend class="form-label">Add an order</legend>
    <div class="kinds">
        @foreach (var (value, label) in Kinds)
        {
            <label class="choice">
                <input type="radio" name="order-kind" checked="@(kind == value)" @onchange="() => Choose(value)" />
                <span>@label</span>
            </label>
        }
    </div>
</fieldset>

@switch (kind)
{
    case "claim":
        var claimable = Game.Claimable(Seat).ToList();
        if (claimable.Count == 0)
        {
            <p class="text-muted">No free region is next to yours.</p>
            break;
        }

        <label class="form-label" for="order-region">Region</label>
        <select id="order-region" class="form-select" value="@Pick(claimable.Select(r => r.Id))" @onchange="e => regionId = int.Parse((string)e.Value!)">
            @foreach (var region in claimable)
            {
                <option value="@region.Id">@region.Name (@region.Terrain.DisplayName())</option>
            }
        </select>
        <p class="cost">
            Cost: <b>@Actions(Rules.ClaimCost)</b>. You draw a card (see the deck below). If others claim it too, a roll
            decides, weighted by 10 + attack power: yours is <b>@N((int)((10 + Me.AttackPower) * Me.Multiplier(EffectKind.ExploreYield)))</b>.
        </p>
        <button type="button" class="btn btn-primary btn-lg w-100" disabled="@Busy" @onclick="() => AddAsync(new ClaimOrder(Pick(claimable.Select(r => r.Id))))">Add claim</button>
        break;

    case "build":
        var buildable = Game.RegionsOf(Seat).Select(r => r.Id).Concat(Draft.OfType<ClaimOrder>().Select(c => c.RegionId)).Distinct().ToList();
        if (buildable.Count == 0)
        {
            <p class="text-muted">You hold no region to build in.</p>
            break;
        }

        <label class="form-label" for="order-region">Region</label>
        <select id="order-region" class="form-select" value="@Pick(buildable)" @onchange="e => regionId = int.Parse((string)e.Value!)">
            @foreach (var id in buildable)
            {
                var region = Game.Board[id];
                <option value="@id">@region.Name: room for @region.FreeSlots(Rules)@(region.Owner != Seat ? " (if you get it)" : "")</option>
            }
        </select>
        <div class="d-flex gap-2 mt-2">
            <label class="choice flex-fill"><input type="radio" name="building" checked="@(building == BuildingType.Town)" @onchange="() => building = BuildingType.Town" /><span>Towns: @Rules.GoldPerTown gold a round</span></label>
            <label class="choice flex-fill"><input type="radio" name="building" checked="@(building == BuildingType.Node)" @onchange="() => building = BuildingType.Node" /><span>Nodes: @Rules.ManaPerNode mana a round</span></label>
        </div>
        <label class="form-label" for="order-count">How many (1–@Rules.BuildingsPerOrder)</label>
        <input id="order-count" type="number" inputmode="numeric" class="form-control" min="1" max="@Rules.BuildingsPerOrder" @bind="count" />
        <p class="cost">Cost: <b>@Actions(Rules.BuildCost)</b> and <b>@N((int)Math.Ceiling(count * Rules.BuildingGoldCost * Me.Multiplier(EffectKind.BuildCost))) gold</b>. Each building adds @Rules.DefensePerBuilding defense and @Rules.PointsPerBuilding points.</p>
        <button type="button" class="btn btn-primary btn-lg w-100" disabled="@Busy" @onclick="() => AddAsync(new BuildOrder(Pick(buildable), building, count))">Add build</button>
        break;

    case "recruit":
        var unit = UnitBook.Find(unitId) ?? UnitBook.All[0];
        <label class="form-label" for="order-unit">Unit</label>
        <select id="order-unit" class="form-select" @bind="unitId">
            @foreach (var u in UnitBook.All)
            {
                <option value="@u.Id">@u.Name: attack @u.Attack, defense @u.Defense, @u.GoldCost gold</option>
            }
        </select>
        <label class="form-label mt-2" for="order-count">How many (1–@Rules.UnitsPerOrder)</label>
        <input id="order-count" type="number" inputmode="numeric" class="form-control" min="1" max="@Rules.UnitsPerOrder" @bind="count" />
        <p class="cost">Cost: <b>@Actions(Rules.RecruitCost)</b> and <b>@N(count * unit.GoldCost) gold</b>, then @N(count * unit.GoldUpkeep * Rules.UpkeepPerRound) gold upkeep a round.</p>
        <button type="button" class="btn btn-primary btn-lg w-100" disabled="@Busy" @onclick="() => AddAsync(new RecruitOrder(unit.Id, count))">Add recruit</button>
        break;

    case "attack":
        var targets = Game.Board.Regions
            .Where(r => r.Owner is { } o && o != Seat && r.Neighbours.Any(n => Game.Board[n].Owner == Seat)).ToList();
        if (targets.Count == 0)
        {
            <p class="text-muted">No other mage's region is next to yours.</p>
            break;
        }

        <label class="form-label" for="order-region">Region to attack</label>
        <select id="order-region" class="form-select" value="@Pick(targets.Select(r => r.Id))" @onchange="e => regionId = int.Parse((string)e.Value!)">
            @foreach (var region in targets)
            {
                <option value="@region.Id">@region.Name (@Game.Seats[region.Owner!.Value].Name): @Percent(Game.AttackChance(Seat, region.Id)) to win</option>
            }
        </select>
        var target = Game.Board[Pick(targets.Select(r => r.Id))];
        <p class="cost">
            Cost: <b>@Actions(Rules.AttackCost)</b>. Your attack @N((int)Game.AttackStrength(Seat, target.Owner!.Value)) against
            their defense @N((int)Game.RegionDefense(target.Id)), both ±@Percent(Rules.CombatRollSpread) luck:
            <b>@Percent(Game.AttackChance(Seat, target.Id)) to win</b> (before other attacks this round). You lose
            @Rules.AttackerLossPercentOnWin% of your units if you win, @Rules.AttackerLossPercentOnLoss% if you lose.
        </p>
        <button type="button" class="btn btn-danger btn-lg w-100" disabled="@Busy" @onclick="() => AddAsync(new AttackOrder(target.Id))">Add attack</button>
        break;

    case "cast":
        var spells = SpellBook.ForSchool(Me.School).ToList();
        <label class="form-label" for="order-spell">Spell</label>
        var spell = spells.FirstOrDefault(s => s.Id == spellId) ?? spells[0];
        <select id="order-spell" class="form-select" value="@spell.Id" @onchange="e => spellId = (string)e.Value!">
            @foreach (var s in spells)
            {
                <option value="@s.Id">@s.Name (@SkirmishSpells.ManaCost(s, Rules) mana)</option>
            }
        </select>
        <p class="cost">@SkirmishSpells.Describe(spell, Rules) Cost: <b>@Actions(Rules.CastCost)</b> and <b>@N(SkirmishSpells.ManaCost(spell, Rules)) mana</b>.</p>
        <button type="button" class="btn btn-primary btn-lg w-100" disabled="@Busy" @onclick="() => AddAsync(new CastOrder(spell.Id))">Add spell</button>
        break;

    case "hex":
        var hex = SpellBook.HexesForSchool(Me.School).First();
        var others = Game.Seats.Where(s => s.Index != Seat && !s.Out).ToList();
        if (others.Count == 0)
        {
            <p class="text-muted">Nobody else is left to hex.</p>
            break;
        }

        <label class="form-label" for="order-target">@hex.Name at</label>
        var victim = others.FirstOrDefault(o => o.Index == targetSeat) ?? others[0];
        <select id="order-target" class="form-select" value="@victim.Index" @onchange="e => targetSeat = int.Parse((string)e.Value!)">
            @foreach (var other in others)
            {
                <option value="@other.Index">@other.Name: @Percent(Game.HexChance(Seat, other.Index)) to land</option>
            }
        </select>
        <p class="cost">
            @SkirmishSpells.Describe(hex, Rules) Cost: <b>@Actions(Rules.CastCost)</b> and <b>@N(Rules.HexMana) mana</b>, spent
            even if it's turned aside. <b>@Percent(Game.HexChance(Seat, victim.Index)) to land</b> on @victim.Name.
        </p>
        <button type="button" class="btn btn-danger btn-lg w-100" disabled="@Busy" @onclick="() => AddAsync(new HexOrder(hex.Id, victim.Index))">Add hex</button>
        break;
}

@code {
    private static readonly (string Value, string Label)[] Kinds =
    [
        ("claim", "Claim"), ("build", "Build"), ("recruit", "Recruit"), ("attack", "Attack"), ("cast", "Spell"), ("hex", "Hex"),
    ];

    private string kind = "claim";
    private int regionId = -1;
    private BuildingType building = BuildingType.Town;
    private int count = 1;
    private string unitId = "unit-1";
    private string spellId = string.Empty;
    private int targetSeat = -1;

    [Parameter, EditorRequired]
    public SkirmishGame Game { get; set; } = default!;

    [Parameter, EditorRequired]
    public int Seat { get; set; }

    /// <summary>The orders saved so far: what's left of the round's actions, and regions claimed in this list.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<SkirmishOrder> Draft { get; set; } = [];

    [Parameter]
    public bool Busy { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<SkirmishOrder> OnAdd { get; set; }

    private SkirmishRules Rules => Game.Rules;

    /// <summary>Switches the kind of order, keeping the count within what the new kind allows.</summary>
    private void Choose(string value)
    {
        kind = value;
        count = Math.Clamp(count, 1, value == "build" ? Rules.BuildingsPerOrder : Rules.UnitsPerOrder);
    }

    private SkirmishSeat Me => Game.Seats[Seat];

    /// <summary>The chosen region if it's one of the options, or else the first option (what the select shows).</summary>
    private int Pick(IEnumerable<int> options)
    {
        var list = options.ToList();
        return list.Contains(regionId) ? regionId : list[0];
    }

    private string Actions(int cost)
    {
        var left = Game.ActionsFor(Seat) - Draft.Sum(o => o.Cost(Rules));
        return $"{cost} action{(cost == 1 ? "" : "s")} ({left} left)";
    }

    private Task AddAsync(SkirmishOrder order) => OnAdd.InvokeAsync(order);

    private static string N(int value) => value.ToString("N0", CultureInfo.InvariantCulture);

    private static string Percent(double share) => share.ToString("0%", CultureInfo.InvariantCulture);
}
