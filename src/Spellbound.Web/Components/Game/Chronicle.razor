@page "/chronicle"
@using Spellbound.Web.Data
@inherits GamePage

<PageTitle>Chronicle</PageTitle>
<h1>Chronicle</h1>
<RoundInfo Round="Round" Rules="Rules" />

@if (Mage is not null)
{
    <p class="text-muted">Every attack and hex this round, as the whole realm hears of it: who struck whom, and how it went.</p>
    @if (entries.Count == 0)
    {
        <p>No mage has struck another yet this round.</p>
    }
    @foreach (var entry in entries)
    {
        <div class="news-entry hostile">
            <small class="text-muted">@Ago(entry.At)</small>
            <p class="mb-1">@entry.Line</p>
        </div>
    }
}

@code {
    private IReadOnlyList<ChronicleEntry> entries = [];

    protected override async Task LoadAsync()
    {
        await base.LoadAsync();
        entries = await Game.GetChronicleAsync();
    }
}
