@page "/"
@using System.Globalization
@using System.Security.Claims
@inject GameService Game
@inject SkirmishService Skirmishes

@* The first page after signing in: the player's games, the current Realm round and their Skirmishes. Not a GamePage:
   a player without a mage belongs here too. *@

<PageTitle>Your games · Spellbound</PageTitle>

<h1>Your games</h1>

@if (!loaded)
{
    <p class="text-muted">Loading…</p>
}
else if (realm is null)
{
    <p>The first round hasn't started yet. Try again in a minute.</p>
}
else
{
    <ul class="rank-list">
        <li>
            <a class="rank-row" href="@(mage is null ? "create" : "realm")">
                <span class="who">
                    <b>The Realm</b>
                    <small class="text-muted d-block">
                        @(mage is null ? "You have no mage this round yet: create one" : $"{mage.Name}, {mage.School.DisplayName()} mage")
                    </small>
                </span>
                @if (mage is not null)
                {
                    <span class="num">@mage.Land.ToString("N0", CultureInfo.InvariantCulture)<small class="text-muted d-block">acres</small></span>
                }
            </a>
        </li>
    </ul>
    <RoundInfo Round="realm.Round" />
}

@if (skirmishes.Count > 0)
{
    <h2 class="h4 mt-4">Skirmishes</h2>
    <ul class="rank-list">
        @foreach (var game in skirmishes)
        {
            <li>
                <a class="rank-row" href="skirmish/@game.GameId">
                    <span class="who">
                        <b>Skirmish @game.Number</b>
                        <small class="text-muted d-block">
                            @(game.Ended
                                ? $"Over: {game.Leader} won"
                                : $"{game.SeatName} · round {game.Planning} of {game.Rounds} · {(game.Ready ? "you're ready" : "your move")} · {game.ReadyCount} of {game.Players} ready")
                        </small>
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool loaded;
    private PlayedGame? realm;
    private Mage? mage;
    private IReadOnlyList<SkirmishSummary> skirmishes = [];

    protected override async Task OnInitializedAsync()
    {
        var ownerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        realm = await Game.GetRealmAsync();
        mage = realm is null ? null : await Game.GetMageAsync(ownerId);
        skirmishes = await Skirmishes.GetMineAsync(ownerId);
        loaded = true;
    }
}
