@* The board as inline SVG (docs/theme.md): pointy-top hexes, each a button. Dark tiles are soot; unveiled ones show
   what a held tile paid this round ("+3"), and units and
   monster guards; a held tile has an inner ring in its owner's ink (heavier for yours). Only the
   selected tile shows its name (A1: row, then place in the row; TileNames). Each type has its painted
   image when all three are there (TileArt, docs/tile-art.md), and otherwise a plain tile with the type's symbol; the
   key to the types is on the help page (MatchHelp). The map is the only way to choose a tile: the orders form says
   what to tap, and the tiles it can use are marked. The tiles are raised, like pieces on a board: each stands on a
   dark copy of itself a little lower (its thickness), and an unveiled tile has a light bevel on its top-left edges and
   a dark one on its bottom-right, all plain polygons (a CSS drop-shadow filter is too slow on phones). In the
   candlelit-table look the board sits on a felt tray (app.css). *@
@inject TileArt Art

<div class="board-tray">
<svg class="hex-map@(Art.Paths is null ? "" : " painted")" viewBox="@ViewBox" role="group" aria-label="The map">
    @if (Art.Paths is not null)
    {
        <defs><clipPath id="hex-clip"><polygon points="@Points(0, 0)" /></clipPath></defs>
    }
    <g class="hex-depth" aria-hidden="true">
        @foreach (var tile in Match.Map.Tiles)
        {
            var (x, y) = Center(tile.Hex);
            <polygon points="@Points(x, y + Depth)" />
        }
    </g>
    @foreach (var tile in Match.Map.Tiles.OrderBy(t => t.Hex.R).ThenBy(t => t.Hex.Q))
    {
        var hex = tile.Hex;
        var (x, y) = Center(hex);
        var owner = Unowned?.Contains(hex) == true ? null : Match.OwnerOf(hex);
        var units = You is { } viewer ? Match.UnitsSeenBy(viewer, hex) : Match.UnitsOn(hex); // null: hidden by the fog
        var classes = "hex" + (tile.IsUnveiled ? "" : " dark") + (Highlight?.Contains(hex) == true ? " marked" : "")
                      + (hex == Selected ? " selected" : "") + (owner == You ? " yours" : "");
        <g class="@classes" role="button" tabindex="0" aria-label="@Seats.Describe(Match, hex, You, Owners, mark: false, named: ShowNames)"
           @onclick="() => OnSelect.InvokeAsync(hex)" @onkeydown="e => KeyAsync(e, hex)">
            @if (tile.IsUnveiled && Art.Paths is { } art)
            {
                <g transform="translate(@F(x) @F(y))" clip-path="url(#hex-clip)">
                    <image href="@Assets[art[tile.Type]]" x="-30" y="-30" width="60" height="60" preserveAspectRatio="xMidYMid slice" />
                </g>
            }
            <polygon class="rim" points="@Points(x, y)" />
            @if (tile.IsUnveiled)
            {
                var corners = Corners(x, y, inset: 1.2);
                <polyline class="bevel-light" points="@string.Join(' ', corners[3], corners[4], corners[5], corners[0])" />
                <polyline class="bevel-dark" points="@string.Join(' ', corners[0], corners[1], corners[2], corners[3])" />
            }
            @if (owner is { } o)
            {
                <polygon class="held" points="@Points(x, y, inset: 3.5)" style="stroke: @Seats.Ink(o)" />
            }
            @if (tile.IsUnveiled)
            {
                @if (ShowNames && hex == Selected)
                {
                    @Label(x, y - 18, "hex-name", TileNames.Of(Match.Map, hex))
                }
                @if (Art.Paths is null)
                {
                    @Label(x, y - 2, $"hex-type {tile.Type.ToString().ToLowerInvariant()}", Seats.Mark(tile.Type))
                }

                @if (owner is not null && Match.Phase != MatchPhase.Opening)
                {
                    // What the tile paid its holder this round: a small hint, the type's range is in the key.
                    <rect class="hex-seal" x="@F(x - 12)" y="@F(y - 7)" width="24" height="16" rx="8" />
                    @Label(x - 3, y + 1, "hex-income", $"+{Match.IncomeOf(hex)}")
                    <g transform="translate(@F(x + 3) @F(y - 3))"><ManaIcon Size="8" /></g>
                }
                @if (tile.IsGuarded)
                {
                    @Label(x, y + 16, "hex-note", $"☠{tile.Guard}")
                }
                else if (units is null && owner is not null)
                {
                    @Label(x, y + 16, "hex-note fog", "?")
                }
                else if (units is { IsEmpty: false } seen)
                {
                    @Label(x, y + 16, "hex-note", UnitText(seen))
                }

                @if (Gains?.TryGetValue(hex, out var gain) == true)
                {
                    <g @key="@($"gain {Round} {hex}")" transform="translate(@F(x) @F(y - 4))">
                        <g class="hex-gain@(gain == 0 ? " none" : "")">
                            <rect x="-18" y="-10" width="36" height="20" rx="10" />
                            @Label(-4, 1, "", $"+{gain}")
                            <g transform="translate(3 -5.5)"><ManaIcon Size="11" /></g>
                        </g>
                    </g>
                }
            }
        </g>
    }
</svg>
</div>

@code {
    private const double Size = 30;

    /// <summary>How far below a tile its thickness shows.</summary>
    private const double Depth = 5;
    private static readonly double Root3 = Math.Sqrt(3);

    [Parameter, EditorRequired]
    public Match Match { get; set; } = default!;

    [Parameter]
    public int? You { get; set; }

    /// <summary>Who sits in each seat (null for a bot), to name them.</summary>
    [Parameter]
    public IReadOnlyList<string?>? Owners { get; set; }

    [Parameter]
    public Hex? Selected { get; set; }

    /// <summary>Tiles to mark, for example the ones on auction.</summary>
    [Parameter]
    public IReadOnlySet<Hex>? Highlight { get; set; }

    [Parameter]
    public EventCallback<Hex> OnSelect { get; set; }

    /// <summary>Tiles to draw as unowned for now (an auction playing back hasn't handed them out yet).</summary>
    [Parameter]
    public IReadOnlySet<Hex>? Unowned { get; set; }

    /// <summary>Whether the selected hex shows its name; the opening leaves it out (only the tile up now matters).</summary>
    [Parameter]
    public bool ShowNames { get; set; } = true;

    /// <summary>What each held tile paid as a round began, shown once as a "+N" rising from it; null otherwise.</summary>
    [Parameter]
    public IReadOnlyDictionary<Hex, int>? Gains { get; set; }

    /// <summary>The round the gains are for: each round's chips are new elements, so their animation plays again.</summary>
    private int Round => Match.CurrentRound;

    private string ViewBox
    {
        get
        {
            var centers = Match.Map.Tiles.Select(t => Center(t.Hex)).ToList();
            var (w, h) = (Size * Root3 / 2 + 2, Size + 2);
            var (minX, minY) = (centers.Min(c => c.X) - w, centers.Min(c => c.Y) - h);
            return $"{F(minX)} {F(minY)} {F(centers.Max(c => c.X) + w - minX)} {F(centers.Max(c => c.Y) + h + Depth - minY)}";
        }
    }

    private static (double X, double Y) Center(Hex hex) => (Size * Root3 * (hex.Q + hex.R / 2.0), Size * 1.5 * hex.R);

    /// <summary>A hex's corners, <paramref name="inset"/> inside its edge (for the owner's ring).</summary>
    private static string Points(double x, double y, double inset = 0) => string.Join(' ', Corners(x, y, inset));

    /// <summary>The corners one by one, clockwise from the upper right (0) through the bottom (2) to the top (5).</summary>
    private static string[] Corners(double x, double y, double inset) =>
        Enumerable.Range(0, 6).Select(i =>
        {
            var angle = Math.PI / 180 * (60 * i - 30);
            return $"{F(x + (Size - 0.5 - inset) * Math.Cos(angle))},{F(y + (Size - 0.5 - inset) * Math.Sin(angle))}";
        }).ToArray();

    private static string UnitText(Army army) =>
        string.Join(' ', new[] { army.Imps > 0 ? $"{army.Imps}i" : null, army.Golems > 0 ? $"{army.Golems}g" : null }.OfType<string>());

    /// <summary>An SVG text element (Razor keeps the text tag for itself).</summary>
    private static MarkupString Label(double x, double y, string css, string text) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" class=\"{css}\">{System.Net.WebUtility.HtmlEncode(text)}</text>");

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private Task KeyAsync(KeyboardEventArgs e, Hex hex) =>
        e.Key is "Enter" or " " ? OnSelect.InvokeAsync(hex) : Task.CompletedTask;
}
