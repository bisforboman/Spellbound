@* The board as inline SVG (docs/theme.md): pointy-top hexes, each a button. Dark tiles are soot under a faint mist (the fog of war, also over a rival's
   tile whose units you can't see); unveiled ones show
   what a held tile paid this round ("+3"), and units and
   monster guards. A held tile has one border, its own edge in its owner's ink (heavier for yours), drawn only
   where the next tile isn't theirs, so a player's tiles together form one zone. Only the
   selected tile shows its name (A1: row, then place in the row; TileNames). Each type has its painted
   image when all three are there (TileArt, docs/tile-art.md), and otherwise a plain tile with the type's symbol (a
   Barren tile is plain ash with its symbol until it has an image of its own); the
   key to the types is on the help page (MatchHelp). The map is the only way to choose a tile: the orders form says
   what to tap, and the tiles it can use are marked. The tiles are raised, like pieces on a board: each stands on a
   dark copy of itself a little lower (its thickness), and an unveiled tile has a light bevel on its top-left edges and
   a dark one on its bottom-right, all plain polygons (a CSS drop-shadow filter is too slow on phones). In the
   candlelit-table look the board sits on a felt tray (app.css). *@
@inject TileArt Art

<div class="board-tray">
<svg class="hex-map@(Art.Paths is null ? "" : " painted")" viewBox="@ViewBox" role="group" aria-label="The map">
    <defs>
        @if (Art.Paths is not null)
        {
            <clipPath id="hex-clip"><polygon points="@Points(0, 0)" /></clipPath>
        }
        @* The fog of war over a dark tile, and over a rival's tile whose units you can't see: a pale mist, lighter at its heart. *@
        <radialGradient id="fog-mist" cx="40%" cy="35%" r="75%">
            <stop offset="0%" stop-color="#c9cfdc" stop-opacity="0.62" />
            <stop offset="55%" stop-color="#9aa1b4" stop-opacity="0.42" />
            <stop offset="100%" stop-color="#5d6274" stop-opacity="0.6" />
        </radialGradient>
    </defs>
    <g class="hex-depth" aria-hidden="true">
        @foreach (var tile in Match.Map.Tiles)
        {
            var (x, y) = Center(tile.Hex);
            <polygon points="@Points(x, y + Depth)" />
        }
    </g>
    @foreach (var tile in Match.Map.Tiles.OrderBy(t => t.Hex.R).ThenBy(t => t.Hex.Q))
    {
        var hex = tile.Hex;
        var (x, y) = Center(hex);
        var unveiled = tile.IsUnveiled && Dark?.Contains(hex) != true;
        var owner = Unowned?.Contains(hex) == true ? null : Match.OwnerOf(hex);
        var units = You is { } viewer ? Match.UnitsSeenBy(viewer, hex) : Match.UnitsOn(hex); // null: hidden by the fog
        var image = unveiled && Art.Paths is { } art && art.TryGetValue(tile.Type, out var path) ? path : null;
        var classes = "hex" + (unveiled ? "" : " dark") + (Highlight?.Contains(hex) == true ? " marked" : "")
                      + (hex == Selected ? " selected" : "") + (owner == You ? " yours" : "") + (owner is null ? "" : " held")
                      + (image is null && unveiled && tile.Type == TileType.Barren ? " barren" : ""); // plain ash until it has art
        <g class="@classes" role="button" tabindex="0" aria-label="@Seats.Describe(Match, hex, You, Owners, mark: false, named: ShowNames)"
           @onclick="() => OnSelect.InvokeAsync(hex)" @onkeydown="e => KeyAsync(e, hex)">
            @if (image is not null)
            {
                <g transform="translate(@F(x) @F(y))" clip-path="url(#hex-clip)">
                    <image href="@Assets[image]" x="-30" y="-30" width="60" height="60" preserveAspectRatio="xMidYMid slice" />
                </g>
            }
            <polygon class="rim" points="@Points(x, y)" />
            @if (!unveiled)
            {
                <polygon class="fog unknown" points="@Points(x, y)" fill="url(#fog-mist)" /> @* nobody knows what's there yet *@
            }
            else if (units is null && owner is not null)
            {
                <polygon class="fog" points="@Points(x, y)" fill="url(#fog-mist)" /> @* its units are hidden: the tile's label says so *@
            }
            @if (unveiled)
            {
                var corners = Corners(x, y, inset: 1.2);
                <polyline class="bevel-light" points="@string.Join(' ', corners[3], corners[4], corners[5], corners[0])" />
                <polyline class="bevel-dark" points="@string.Join(' ', corners[0], corners[1], corners[2], corners[3])" />
            }
            @if (unveiled)
            {
                @if (ShowNames && hex == Selected)
                {
                    @Label(x, y - 18, "hex-name", TileNames.Of(Match.Map, hex))
                }
                @if (image is null)
                {
                    @Label(x, y - 2, $"hex-type {tile.Type.ToString().ToLowerInvariant()}", Seats.Mark(tile.Type))
                }

                @if (owner is not null && Match.Phase != MatchPhase.Opening)
                {
                    // What the tile paid its holder this round: a small hint, the type's range is in the key.
                    <rect class="hex-seal" x="@F(x - 12)" y="@F(y - 7)" width="24" height="16" rx="8" />
                    @Label(x - 3, y + 1, "hex-income", $"+{Match.IncomeOf(hex)}")
                    <g transform="translate(@F(x + 3) @F(y - 3))"><ManaIcon Size="8" /></g>
                }
                @if (tile.IsGuarded)
                {
                    @Label(x, y + 16, "hex-note", $"☠{tile.Guard}")
                }
                else if (units is { IsEmpty: false } seen)
                {
                    @Label(x, y + 16, "hex-note", UnitText(seen))
                }

                @if (Gains?.TryGetValue(hex, out var gain) == true)
                {
                    <g @key="@($"gain {Round} {hex}")" transform="translate(@F(x) @F(y - 4))">
                        <g class="hex-gain@(gain == 0 ? " none" : "")">
                            <rect x="-18" y="-10" width="36" height="20" rx="10" />
                            @Label(-4, 1, "", $"+{gain}")
                            <g transform="translate(3 -5.5)"><ManaIcon Size="11" /></g>
                        </g>
                    </g>
                }
            }
        </g>
    }
    @* The zones, over every tile so a neighbour's art can't cover them. *@
    <g class="zones">
        @foreach (var tile in Match.Map.Tiles)
        {
            if (OwnerAt(tile.Hex) is not { } o)
            {
                continue;
            }

            var (x, y) = Center(tile.Hex);
            var inset = o == You ? 1.125 : 0.75; // half the stroke, so the border sits just inside the edge
            <path class="@(o == You ? "zone yours" : "zone")" style="stroke: @Seats.Ink(o)" d="@ZoneEdges(tile.Hex, o, x, y, inset)" />
        }
    </g>
    @* What just happened, played once over the board (BeatEffects): new elements for each beat, so each plays afresh. *@
    @if (Effects is { Count: > 0 } effects)
    {
        <g class="effects" @key="EffectsKey" aria-hidden="true">
            @foreach (var fx in effects)
            {
                var (x, y) = Center(fx.At);
                var ink = Seats.Ink(fx.Seat);
                switch (fx.Kind)
                {
                    case EffectKind.Summon:
                        <circle class="fx-ring" cx="@F(x)" cy="@F(y)" r="20" style="stroke: @ink" />
                        @Label(x, y - 14, "fx-pop", fx.Label ?? "+")
                        break;
                    case EffectKind.Attack:
                        @if (fx.From is { } from)
                        {
                            var (fx0, fy0) = Center(from);
                            <g class="fx-army" style="--dx: @F(x - fx0)px; --dy: @F(y - fy0)px">
                                <circle cx="@F(fx0)" cy="@F(fy0)" r="9" style="fill: @ink" />
                            </g>
                        }
                        <path class="fx-clash" d="@ClashPath(x, y)" />
                        break;
                    case EffectKind.Take:
                        <polygon class="fx-wash" points="@Points(x, y)" style="--c: @ink; stroke: @ink" />
                        break;
                    case EffectKind.Cast:
                        <g class="fx-glyph">
                            <circle cx="@F(x)" cy="@F(y)" r="21" />
                            <path d="@GlyphPath(x, y)" />
                        </g>
                        break;
                }
            }
        </g>
    }
</svg>
</div>

@code {
    private const double Size = 30;

    /// <summary>How far below a tile its thickness shows.</summary>
    private const double Depth = 5;
    private static readonly double Root3 = Math.Sqrt(3);

    [Parameter, EditorRequired]
    public Match Match { get; set; } = default!;

    [Parameter]
    public int? You { get; set; }

    /// <summary>Who sits in each seat (null for a bot), to name them.</summary>
    [Parameter]
    public IReadOnlyList<string?>? Owners { get; set; }

    [Parameter]
    public Hex? Selected { get; set; }

    /// <summary>Tiles to mark, for example the ones to pick in the draft.</summary>
    [Parameter]
    public IReadOnlySet<Hex>? Highlight { get; set; }

    [Parameter]
    public EventCallback<Hex> OnSelect { get; set; }

    /// <summary>Tiles to draw as unowned for now (a draft playing back hasn't handed them out yet).</summary>
    [Parameter]
    public IReadOnlySet<Hex>? Unowned { get; set; }

    /// <summary>Tiles to draw dark for now (a draft playing back hasn't reached the Unveil that turned them over).</summary>
    [Parameter]
    public IReadOnlySet<Hex>? Dark { get; set; }

    /// <summary>Whether the selected hex shows its name; the opening leaves it out (only the tile up now matters).</summary>
    [Parameter]
    public bool ShowNames { get; set; } = true;

    /// <summary>What each held tile paid as a round began, shown once as a "+N" rising from it; null otherwise.</summary>
    [Parameter]
    public IReadOnlyDictionary<Hex, int>? Gains { get; set; }

    /// <summary>What just happened, to play once over the board (a playback beat's effects); null for none.</summary>
    [Parameter]
    public IReadOnlyList<Effect>? Effects { get; set; }

    /// <summary>Which beat the effects are for: a new key draws them afresh, so they play again.</summary>
    [Parameter]
    public int EffectsKey { get; set; }

    /// <summary>An attack's flash: a cross over the target.</summary>
    private static string ClashPath(double x, double y) =>
        $"M{F(x - 13)},{F(y - 13)} L{F(x + 13)},{F(y + 13)} M{F(x + 13)},{F(y - 13)} L{F(x - 13)},{F(y + 13)}";

    /// <summary>A spell's glyph: a four-pointed star on the tile.</summary>
    private static string GlyphPath(double x, double y) =>
        $"M{F(x)},{F(y - 15)} L{F(x + 4)},{F(y - 4)} L{F(x + 15)},{F(y)} L{F(x + 4)},{F(y + 4)} L{F(x)},{F(y + 15)} "
        + $"L{F(x - 4)},{F(y + 4)} L{F(x - 15)},{F(y)} L{F(x - 4)},{F(y - 4)} Z";

    /// <summary>The round the gains are for: each round's chips are new elements, so their animation plays again.</summary>
    private int Round => Match.CurrentRound;

    private string ViewBox
    {
        get
        {
            var centers = Match.Map.Tiles.Select(t => Center(t.Hex)).ToList();
            var (w, h) = (Size * Root3 / 2 + 2, Size + 2);
            var (minX, minY) = (centers.Min(c => c.X) - w, centers.Min(c => c.Y) - h);
            return $"{F(minX)} {F(minY)} {F(centers.Max(c => c.X) + w - minX)} {F(centers.Max(c => c.Y) + h + Depth - minY)}";
        }
    }

    private static (double X, double Y) Center(Hex hex) => (Size * Root3 * (hex.Q + hex.R / 2.0), Size * 1.5 * hex.R);

    /// <summary>A hex's corners.</summary>
    private static string Points(double x, double y) => string.Join(' ', Corners(x, y, 0));

    /// <summary>The corners one by one, clockwise from the upper right (0) through the bottom (2) to the top (5).</summary>
    private static string[] Corners(double x, double y, double inset) =>
        Enumerable.Range(0, 6).Select(i => Corner(x, y, i, inset)).Select(c => $"{F(c.X)},{F(c.Y)}").ToArray();

    private static (double X, double Y) Corner(double x, double y, int i, double inset)
    {
        var angle = Math.PI / 180 * (60 * i - 30);
        return (x + (Size - 0.5 - inset) * Math.Cos(angle), y + (Size - 0.5 - inset) * Math.Sin(angle));
    }

    /// <summary>Who holds a tile as drawn: nobody if it is dark, <see cref="Dark"/> or <see cref="Unowned"/> for now.</summary>
    private int? OwnerAt(Hex hex) =>
        !Match.Map.Contains(hex) || !Match.Map[hex].IsUnveiled || Dark?.Contains(hex) == true || Unowned?.Contains(hex) == true
            ? null
            : Match.OwnerOf(hex);

    /// <summary>The edges of a held tile that face a tile not held by the same seat, as one SVG path.</summary>
    private string ZoneEdges(Hex hex, int owner, double x, double y, double inset)
    {
        var path = new System.Text.StringBuilder();
        for (var i = 0; i < 6; i++)
        {
            if (OwnerAt(new Hex(hex.Q + EdgeNeighbour[i].Q, hex.R + EdgeNeighbour[i].R)) == owner)
            {
                continue;
            }

            var (x1, y1) = Corner(x, y, i, inset);
            var (x2, y2) = Corner(x, y, i + 1, inset);
            path.Append($"M{F(x1)},{F(y1)}L{F(x2)},{F(y2)}");
        }

        return path.ToString();
    }

    /// <summary>The neighbour across each edge: edge i runs from corner i to corner i + 1, facing 60 × i degrees.</summary>
    private static readonly Hex[] EdgeNeighbour = [new(1, 0), new(0, 1), new(-1, 1), new(-1, 0), new(0, -1), new(1, -1)];

    private static string UnitText(Army army) =>
        string.Join(' ', new[] { army.Imps > 0 ? $"{army.Imps}i" : null, army.Golems > 0 ? $"{army.Golems}g" : null }.OfType<string>());

    /// <summary>An SVG text element (Razor keeps the text tag for itself).</summary>
    private static MarkupString Label(double x, double y, string css, string text) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" class=\"{css}\">{System.Net.WebUtility.HtmlEncode(text)}</text>");

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private Task KeyAsync(KeyboardEventArgs e, Hex hex) =>
        e.Key is "Enter" or " " ? OnSelect.InvokeAsync(hex) : Task.CompletedTask;
}
