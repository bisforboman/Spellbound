@page "/skirmish/join/{Code}"
@using System.Security.Claims
@using Spellbound.Domain.Skirmish
@implements IDisposable
@inject SkirmishLobbyService Lobbies
@inject SkirmishService Skirmishes
@inject NavigationManager Navigation

@* A Skirmish waiting for players, at the address its invite link points to. Players see who has joined and the rules,
   and join under a name and school; those who have joined see the code to share, and the page moves on to the game by
   itself once it starts. *@

<PageTitle>Join a Skirmish · Spellbound</PageTitle>

@if (lobby is null)
{
    <h1>Join a Skirmish</h1>
    <p>@(loaded ? "No game has that code. Check it with whoever sent it." : "Loading…")</p>
    <p><a class="btn btn-link px-0" href="">Back to your games</a></p>
    return;
}

@if (lobby.Started)
{
    <h1>Join a Skirmish</h1>
    <p>That game has already started.</p>
    <p><a class="btn btn-link px-0" href="">Back to your games</a></p>
    return;
}

@{
    var joined = lobby.Has(ownerId);
    var creator = lobby.CreatorId == ownerId;
}

<h1>Skirmish @lobby.Code</h1>
<p><b>@lobby.Players.Count of @lobby.Rules.Players</b> players have joined. It starts when it's full@(creator ? ", or when you start it" : "").</p>

@if (problem is not null)
{
    <p class="alert alert-danger" role="alert">@problem</p>
}

<ul class="rank-list">
    @for (var i = 0; i < lobby.Players.Count; i++)
    {
        var player = lobby.Players[i];
        <li class="rank-row seated seat-@i @(player.OwnerId == ownerId ? "you" : "")">
            <span class="who"><b class="seat-name">@player.Name</b><small class="text-muted d-block">@player.School.DisplayName()@(player.OwnerId == lobby.CreatorId ? " · set it up" : "")</small></span>
        </li>
    }
</ul>

@if (joined)
{
    <h2 class="h4">Invite players</h2>
    <p>Send them the code <b class="invite-code">@lobby.Code</b> or this link:</p>
    <input class="form-control mb-3" readonly value="@Link" aria-label="Invite link" onfocus="this.select()" />
    @if (creator)
    {
        @if (lobby.Players.Count >= SkirmishRules.MinPlayers)
        {
            <button type="button" class="btn btn-primary btn-lg w-100 mb-2" disabled="@busy" @onclick="StartAsync">Start now with @lobby.Players.Count players</button>
        }

        <button type="button" class="btn btn-outline-danger w-100" disabled="@busy" @onclick="LeaveAsync">Call off the game</button>
    }
    else
    {
        <button type="button" class="btn btn-outline-secondary w-100" disabled="@busy" @onclick="LeaveAsync">Leave the game</button>
    }
}
else if (lobby.Players.Count < lobby.Rules.Players)
{
    <h2 class="h4">Join</h2>
    <form @onsubmit="JoinAsync">
        <SkirmishMageFields @bind-Name="name" @bind-School="school" />
        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@busy">Join the game</button>
    </form>
}
else
{
    <p>This game is full.</p>
}

<h2 class="h4 mt-4">Rules</h2>
<SkirmishRulesList Rules="lobby.Rules" RoundLength="lobby.RoundLength" />
<p><a class="btn btn-link px-0" href="">Back to your games</a></p>

@code {
    private static readonly TimeSpan Refresh = TimeSpan.FromSeconds(5);

    [Parameter]
    public string Code { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string ownerId = string.Empty;
    private SkirmishLobby? lobby;
    private bool loaded;
    private bool busy;
    private string? problem;
    private string name = string.Empty;
    private MagicSchool school = MagicSchool.A;
    private Timer? timer;

    private string Link => $"{Navigation.BaseUri}skirmish/join/{lobby!.Code}";

    protected override async Task OnInitializedAsync()
    {
        ownerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        (name, school) = await Lobbies.SuggestAsync(ownerId);
        await LoadAsync();
        timer = new Timer(_ => InvokeAsync(ReloadQuietlyAsync), null, Refresh, Refresh);
    }

    public void Dispose() => timer?.Dispose();

    /// <summary>Loads the lobby; once it has started, a player who is in the game goes to it.</summary>
    private async Task LoadAsync()
    {
        lobby = await Lobbies.FindAsync(Code);
        loaded = true;
        if (lobby?.GameId is { } gameId && await Skirmishes.GetAsync(gameId, ownerId) is not null)
        {
            timer?.Dispose();
            Navigation.NavigateTo($"skirmish/{gameId}");
        }
    }

    /// <summary>The refresh, so players joining and the start show up by themselves. Never ends the page's connection.</summary>
    private async Task ReloadQuietlyAsync()
    {
        if (busy)
        {
            return;
        }

        try
        {
            await LoadAsync();
            if (lobby is null || lobby.Started)
            {
                timer?.Dispose();
            }

            StateHasChanged();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // A missed refresh is harmless: the next one, or the player's next tap, loads the lobby again.
        }
    }

    private Task JoinAsync() => RunAsync(() => Lobbies.JoinAsync(Code, ownerId, name, school));

    private Task StartAsync() => RunAsync(() => Lobbies.StartNowAsync(Code, ownerId));

    private async Task LeaveAsync()
    {
        await RunAsync(() => Lobbies.LeaveAsync(Code, ownerId));
        if (problem is null)
        {
            Navigation.NavigateTo("");
        }
    }

    private async Task RunAsync(Func<Task<string?>> change)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        problem = await change();
        await LoadAsync();
        busy = false;
    }
}
