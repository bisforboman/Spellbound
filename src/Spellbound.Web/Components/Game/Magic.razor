@page "/magic"
@page "/cast"
@page "/meditate"
@inherits GamePage

<PageTitle>Magic</PageTitle>
<h1>Magic</h1>

@if (Mage is not null)
{
    <TurnsBar Mage="Mage" />
    <p>Mana: @N(Mage.Mana) / @N(Mage.ManaCapacity(Rules)).</p>

    <h2 class="h4">Meditate</h2>
    <p>Each turn of meditation adds <b>@N(Mage.MeditateManaPerTurn(Rules))</b> mana on top of your nodes' income.</p>
    <form @onsubmit="() => Run(MeditateSection, () => Game.MeditateAsync(OwnerId, turns))">
        <label class="form-label" for="turns">Turns to spend</label>
        <input id="turns" type="number" inputmode="numeric" class="form-control form-control-lg" min="1" max="@Mage.Turns" @bind="turns" @bind:event="oninput" />
        <p class="cost">Cost: <b>@Turns(turns)</b></p>
        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@Busy">Meditate</button>
    </form>
    @if (reportFor == MeditateSection)
    {
        <ReportView Report="Report" />
    }

    <h2 class="h4 mt-4">Spells</h2>
    @foreach (var spell in SpellBook.ForSchool(Mage.School))
    {
        var active = Mage.ActiveEffects.FirstOrDefault(e => e.SpellId == spell.Id);
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="h5 card-title">@spell.Name</h3>
                <p class="card-text">@spell.Description</p>
                <p class="cost">Cost: <b>@N(spell.ManaCost) mana</b> and <b>@Turns(spell.TurnCost)</b>. Lasts @spell.DurationTurns turns.</p>
                @if (active is not null)
                {
                    <p class="text-muted">Active, @active.RemainingTurns turns left. Casting again restarts the duration.</p>
                }
                <button type="button" class="btn btn-primary btn-lg w-100" disabled="@Busy"
                        @onclick="() => Run(spell.Id, () => Game.CastAsync(OwnerId, spell.Id))">
                    @(active is null ? "Cast" : "Renew") @spell.Name
                </button>
                @if (reportFor == spell.Id)
                {
                    <ReportView Report="Report" />
                }
            </div>
        </div>
    }

    <h2 class="h4 mt-4">Hexes</h2>
    @foreach (var hex in SpellBook.HexesForSchool(Mage.School))
    {
        <p><b>@hex.Name</b>: @hex.Description Costs @N(hex.ManaCost) mana and @Turns(hex.TurnCost).</p>
    }
    <p>Cast hexes at another mage from their page under <a href="rivals">Rivals</a>.</p>
}

@code {
    private const string MeditateSection = "meditate";

    private int turns = 5;
    private string? reportFor;

    /// <summary>Shows the report next to the button that was tapped, so it's in view on a long page.</summary>
    private Task Run(string section, Func<Task<ActionReport>> action)
    {
        reportFor = section;
        return RunAsync(action);
    }
}
