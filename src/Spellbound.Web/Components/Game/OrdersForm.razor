@* A round's orders (docs/game-design.md, Rounds and stances): one stance, what it aims at, and for an attack the units
   that go. The tile comes from the map or the plain choices here; the preview is Match.Check's own lines. *@

<h2 class="h4">Round @Match.CurrentRound of @Match.Rules.Rounds: your stance</h2>

<fieldset class="stances">
    @foreach (var choice in Choices)
    {
        var s = choice;
        <label class="choice">
            <input type="radio" name="stance" checked="@(stance == s.Key)" @onchange="() => stance = s.Key" />
            <span><b>@s.Key</b>: @s.Value</span>
        </label>
    }
</fieldset>

@switch (stance)
{
    case "Attune":
        <p>Tap a free tile next to your land, or choose one:</p>
        @Targets(FreeNextToYou())
        break;

    case "Summon":
        <p>Tap one of your tiles, or choose one:</p>
        @Targets(Me.Tiles.OrderBy(h => h.Q).ThenBy(h => h.R))
        <div class="d-flex gap-2 mt-2">
            <label class="choice flex-fill">
                <input type="radio" name="kind" checked="@(kind == UnitKind.Imp)" @onchange="() => kind = UnitKind.Imp" />
                <span><b>Imps</b>: power @Match.Rules.ImpPower, @Match.Rules.ImpCost mana</span>
            </label>
            <label class="choice flex-fill">
                <input type="radio" name="kind" checked="@(kind == UnitKind.Golem)" @onchange="() => kind = UnitKind.Golem" />
                <span><b>Golems</b>: power @Match.Rules.GolemPower, @Match.Rules.GolemCost mana, upkeep @Match.Rules.GolemUpkeep</span>
            </label>
        </div>
        <label class="form-label" for="count">How many</label>
        <input id="count" type="number" class="form-control form-control-lg" min="1" @bind="count" @bind:event="oninput" />
        break;

    case "Build":
        <p>Tap one of your tiles without an upgrade, or choose one (@Match.Rules.UpgradeCost mana; at most
            @Match.Rules.UpgradeCap upgrades; each is worth @Match.Rules.PointsPerUpgrade point at the end and passes with the tile if it's taken):</p>
        @Targets(Me.Tiles.Where(h => Match.UpgradeOn(h) is null).OrderBy(h => h.Q).ThenBy(h => h.R))
        @foreach (var kind in Enum.GetValues<Upgrade>())
        {
            var k = kind;
            <label class="choice mt-2">
                <input type="radio" name="upgrade" checked="@(upgrade == k)" @onchange="() => upgrade = k" />
                <span><b>@k</b>: @Match.UpgradeEffect(k)</span>
            </label>
        }
        break;

    case "Attack":
        <p>Tap a rival's tile or a monster tile next to your units, or choose one:</p>
        @Targets(AttackTargets())
        @if (Selected is { } target && AttackTargets().Contains(target))
        {
            <p class="mt-2">Send from:</p>
            @foreach (var from in Sources(target))
            {
                var f = from;
                var here = AfterMoves(f);
                var sent = sends.GetValueOrDefault(f, here);
                <div class="attack-source">
                    <span>@f (@here)</span>
                    @if (here.Imps > 0)
                    {
                        <label>Imps <input type="number" class="form-control" min="0" max="@here.Imps" value="@sent.Imps"
                                           @oninput="e => Send(f, sent with { Imps = Parse(e, here.Imps) })" /></label>
                    }
                    @if (here.Golems > 0)
                    {
                        <label>Golems <input type="number" class="form-control" min="0" max="@here.Golems" value="@sent.Golems"
                                             @oninput="e => Send(f, sent with { Golems = Parse(e, here.Golems) })" /></label>
                    }
                </div>
            }

            <label class="form-label mt-2" for="reinforce-at">Guard home (optional)</label>
            <p class="text-muted">While your army is away: up to @Match.Rules.ReinforceMaxPower power of units, @Match.Rules.ReinforceSurcharge
                mana more each than a summon. They can't join the attack.</p>
            <select id="reinforce-at" class="form-select" @bind="reinforceAt">
                <option value="">No reinforcements</option>
                @foreach (var h in Me.Tiles.OrderBy(h => h.Q).ThenBy(h => h.R))
                {
                    <option value="@Key(h)">@Seats.Describe(Match, h, You, Owners)</option>
                }
            </select>
            @if (Parse(reinforceAt) is not null)
            {
                <div class="attack-source">
                    <label>Imps <input id="reinforce-imps" type="number" class="form-control" min="1"
                                       max="@(Match.Rules.ReinforceMaxPower / Match.Rules.ImpPower)" @bind="reinforceImps" @bind:event="oninput" /></label>
                </div>
            }
        }
        break;

    default:
        <p>Hold: spend nothing this round.</p>
        break;
}

<button type="button" class="fold-head" aria-expanded="@showMoves" @onclick="() => showMoves = !showMoves">
    <span class="fold-title">Moves (optional) @(showMoves ? "▾" : "▸")</span>
    <span class="fold-sum">@(moves.Count == 0 ? "none" : $"{moves.Count} planned")</span>
</button>
@if (showMoves)
{
<div class="fold-body">
<p class="text-muted">Units step to a neighbouring tile of yours, once a round. Moves happen first, so moved units can attack.</p>
@foreach (var move in moves.ToList())
{
    var m = move;
    <div class="attack-source">
        <span>@m.Units from @m.From to @m.To</span>
        <button type="button" class="btn btn-link" @onclick="() => moves.Remove(m)">Remove</button>
    </div>
}
@if (MoveFroms().Any())
{
    <div class="move-form">
        <label class="form-label" for="move-from">From</label>
        <select id="move-from" class="form-select" @bind="moveFrom" @bind:after="FromChosen">
            <option value="">Choose a tile with units</option>
            @foreach (var h in MoveFroms())
            {
                <option value="@Key(h)">@h (@Movable(h))</option>
            }
        </select>
        @if (Parse(moveFrom) is { } from)
        {
            <label class="form-label mt-2" for="move-to">To</label>
            <select id="move-to" class="form-select" @bind="moveTo">
                <option value="">Choose a neighbouring tile of yours</option>
                @foreach (var h in Me.Tiles.Where(from.IsNextTo).OrderBy(h => h.Q).ThenBy(h => h.R))
                {
                    <option value="@Key(h)">@h</option>
                }
            </select>
            var movable = Movable(from);
            <div class="attack-source">
                @if (movable.Imps > 0)
                {
                    <label>Imps <input type="number" class="form-control" min="0" max="@movable.Imps" @bind="moveImps" /></label>
                }
                @if (movable.Golems > 0)
                {
                    <label>Golems <input type="number" class="form-control" min="0" max="@movable.Golems" @bind="moveGolems" /></label>
                }
            </div>
            <button type="button" class="btn btn-outline-primary btn-lg w-100 mt-2" disabled="@(Parse(moveTo) is null)" @onclick="AddMove">Add this move</button>
        }
    </div>
}
</div>
}

<button type="button" class="fold-head" aria-expanded="@showSpell" @onclick="() => showSpell = !showSpell">
    <span class="fold-title">Spell (optional) @(showSpell ? "▾" : "▸")</span>
    <span class="fold-sum">@SpellSummary()</span>
</button>
@if (showSpell)
{
<div class="fold-body">
<p class="text-muted">One spell a round, paid on top of the stance. Spells work after Attunes and Summons, before attacks.</p>
<fieldset class="spells">
    <label class="choice">
        <input type="radio" name="spell" checked="@(spell is null)" @onchange="() => ChooseSpell(null)" />
        <span><b>No spell</b></span>
    </label>
    @foreach (var choice in SpellChoices())
    {
        var c = choice;
        <label class="choice">
            <input type="radio" name="spell" checked="@(spell == c.Spell)" @onchange="() => ChooseSpell(c.Spell)" />
            <span><b>@c.Spell</b> (@c.Cost): @c.Effect</span>
        </label>
    }
</fieldset>
@if (spell is { } chosen)
{
    var targets = SpellTargets(chosen).ToList();
    <div class="move-form">
        @if (targets.Count == 0)
        {
            <p class="text-muted">@(chosen == Spell.Rally ? "Rally goes with an attack: choose Attack and the tile you attack first." : $"No tile for {chosen} this round.")</p>
        }
        else
        {
            <label class="form-label" for="spell-target">@(chosen == Spell.Leyline ? "From" : "On")</label>
            <select id="spell-target" class="form-select" @bind="spellTarget" @bind:after="SpellTargetChosen">
                <option value="">Choose a tile</option>
                @foreach (var h in targets)
                {
                    <option value="@Key(h)">@Seats.Describe(Match, h, You, Owners)</option>
                }
            </select>
        }
        @if (Parse(spellTarget) is { } on)
        {
            @if (chosen == Spell.Scorch)
            {
                <label class="form-label mt-2" for="scorch-power">Power to burn (@Match.Rules.ScorchManaPerPower mana each)</label>
                <input id="scorch-power" type="number" class="form-control form-control-lg" min="1" max="@Match.UnitsOn(on).Power(Match.Rules)"
                       @bind="scorchPower" @bind:event="oninput" />
            }
            else if (chosen == Spell.Leyline)
            {
                <label class="form-label mt-2" for="leyline-to">To</label>
                <select id="leyline-to" class="form-select" @bind="leylineTo">
                    <option value="">Choose another tile of yours</option>
                    @foreach (var h in Me.Tiles.Where(h => h != on).OrderBy(h => h.Q).ThenBy(h => h.R))
                    {
                        <option value="@Key(h)">@h</option>
                    }
                </select>
                var free = Riders(on);
                <div class="attack-source">
                    @if (free.Imps > 0)
                    {
                        <label>Imps <input id="leyline-imps" type="number" class="form-control" min="0" max="@free.Imps" @bind="leylineImps" @bind:event="oninput" /></label>
                    }
                    @if (free.Golems > 0)
                    {
                        <label>Golems <input id="leyline-golems" type="number" class="form-control" min="0" max="@free.Golems" @bind="leylineGolems" @bind:event="oninput" /></label>
                    }
                </div>
            }
        }
    </div>
}
</div>
}

@if (Match.Seats.Any(s => s.Index != You && s.Trait is not null && !Me.Guesses.ContainsKey(s.Index)))
{
<button type="button" class="fold-head" aria-expanded="@showGuess" @onclick="() => showGuess = !showGuess">
    <span class="fold-title">Guess a trait (optional) @(showGuess ? "▾" : "▸")</span>
    <span class="fold-sum">@(GuessFor is { } g && guessTrait is { } gt ? $"{RivalName(g)}: {gt}" : "none")</span>
</button>
@if (showGuess)
{
<div class="fold-body">
    <p class="text-muted">Traits stay secret until the end. Guess one rival's: @Plural(Match.Rules.PointsPerTraitGuess, "point")
        at the end if you're right (at most @Match.Rules.TraitGuessCap). Once per rival; a guess can't be changed.</p>
    <label class="form-label" for="guess-rival">Rival</label>
    <select id="guess-rival" class="form-select" @bind="guessRival">
        <option value="">No guess this round</option>
        @foreach (var rival in Match.Seats.Where(s => s.Index != You && s.Trait is not null && !Me.Guesses.ContainsKey(s.Index)))
        {
            <option value="@rival.Index">@RivalName(rival.Index)</option>
        }
    </select>
    @if (GuessFor is not null)
    {
        <label class="form-label mt-2" for="guess-trait">Their trait</label>
        <select id="guess-trait" class="form-select" @bind="guessTrait">
            <option value="">Choose a trait</option>
            @foreach (var t in Enum.GetValues<Trait>().Where(t => !Me.Offer.Contains(t)))
            {
                <option value="@t">@t: @Match.GoalText(t)</option>
            }
        </select>
    }
</div>
}
}

@{
    var orders = Build();
    var check = orders is null ? null : Match.Check(orders);
}
@if (check is null && spell is { } waiting && BuildStance() is not null)
{
    <p class="text-muted mt-2">Choose where @waiting goes, or choose No spell.</p>
}
@if (check is not null)
{
    <div class="ledger mt-2">
        @foreach (var line in check.Lines)
        {
            <p class="@(check.Succeeded ? "ledger-line" : "ledger-problem")">@line</p>
        }
    </div>
}
<div class="action-bar">
    <p class="action-sum @(check is { Succeeded: false } ? "ledger-problem" : "")">@ActionSummary(check)</p>
    <div class="action-row">
        <button type="button" class="btn btn-primary btn-lg" disabled="@(Busy || check is not { Succeeded: true })"
                @onclick="() => OnCommit.InvokeAsync(orders!)">Commit: @stance@(orders?.Cast is { } cast ? $" and {cast.Spell}" : "")@(orders?.Guess is not null ? " and guess" : "")</button>
    </div>
</div>

@code {
    private static readonly IReadOnlyDictionary<string, string> Choices = new Dictionary<string, string>
    {
        ["Attune"] = "claim a free tile next to your land",
        ["Summon"] = "spend mana on units",
        ["Attack"] = "send units at a rival's or a monster's tile",
        ["Build"] = "an upgrade on one of your tiles",
        ["Hold"] = "do nothing this round",
    };

    [Parameter, EditorRequired]
    public Match Match { get; set; } = default!;

    [Parameter]
    public int You { get; set; }

    [Parameter]
    public IReadOnlyList<string?>? Owners { get; set; }

    [Parameter]
    public Hex? Selected { get; set; }

    [Parameter]
    public EventCallback<Hex> OnSelect { get; set; }

    [Parameter]
    public EventCallback<Orders> OnCommit { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    private string stance = "Summon";
    private UnitKind kind = UnitKind.Imp;
    private Upgrade upgrade = Upgrade.Shrine;
    private int count = 1;
    private readonly Dictionary<Hex, Army> sends = [];
    private readonly List<Move> moves = [];
    private string moveFrom = string.Empty;
    private string moveTo = string.Empty;
    private int moveImps;
    private int moveGolems;
    private int round;
    private bool showMoves;
    private bool showSpell;
    private bool showGuess;
    private string reinforceAt = string.Empty;
    private int reinforceImps = 3;
    private string guessRival = string.Empty;
    private Trait? guessTrait;
    private Spell? spell;
    private string spellTarget = string.Empty;
    private int scorchPower = 1;
    private string leylineTo = string.Empty;
    private int leylineImps;
    private int leylineGolems;

    private Seat Me => Match.Seats[You];

    protected override void OnParametersSet()
    {
        if (round != Match.CurrentRound)
        {
            round = Match.CurrentRound;
            sends.Clear();
            moves.Clear();
            count = 1;
            ChooseSpell(null);
            (guessRival, guessTrait) = (string.Empty, null);
            (reinforceAt, reinforceImps) = (string.Empty, 3);
        }
    }

    /// <summary>The orders as chosen so far, with the spell if one is chosen, or null if they don't aim at anything
    /// yet.</summary>
    private Orders? Build() => BuildStance() is { } orders && WithSpell(orders) is { } all ? WithGuess(WithReinforcement(all)) : null;

    private Orders WithReinforcement(Orders orders) =>
        stance == "Attack" && Parse(reinforceAt) is { } at ? orders.Reinforcing(at, UnitKind.Imp, reinforceImps) : orders;

    private Orders WithGuess(Orders orders) =>
        GuessFor is { } rival && guessTrait is { } trait ? orders.Guessing(rival, trait) : orders;

    private int? GuessFor => int.TryParse(guessRival, CultureInfo.InvariantCulture, out var r) ? r : null;

    private string RivalName(int seat) => Owners is { } owners && seat < owners.Count && owners[seat] is not null ? $"Seat {seat + 1}" : $"Bot {seat + 1}";

    private static string Plural(int n, string word) => n == 1 ? $"1 {word}" : $"{n} {word}s";

    private Orders? WithSpell(Orders orders)
    {
        if (spell is not { } chosen)
        {
            return orders;
        }

        if (Parse(spellTarget) is not { } on)
        {
            return null;
        }

        if (chosen != Spell.Leyline)
        {
            return orders.Casting(chosen, on, chosen == Spell.Scorch ? scorchPower : 0);
        }

        return Parse(leylineTo) is { } to
            ? orders.CastingLeyline(new Move(on, to, new Army(Math.Max(0, leylineImps), Math.Max(0, leylineGolems))))
            : null;
    }

    private Orders? BuildStance() => (stance, Selected) switch
    {
        ("Hold", _) => Orders.Hold(You, [.. moves]),
        (_, null) => null,
        ("Attune", { } t) => Orders.Attune(You, t, [.. moves]),
        ("Build", { } t) => Orders.Build(You, t, upgrade, [.. moves]),
        ("Summon", { } t) => Orders.Summon(You, t, kind, count, [.. moves]),
        ("Attack", { } t) => Orders.Attack(You, t,
            [.. Sources(t).Select(f => new Move(f, t, sends.GetValueOrDefault(f, AfterMoves(f)))).Where(m => !m.Units.IsEmpty)],
            [.. moves]),
        _ => null,
    };

    /// <summary>The units on a tile once the planned moves are made.</summary>
    private Army AfterMoves(Hex hex) =>
        moves.Aggregate(Match.UnitsOn(hex), (army, m) => m.From == hex ? army - m.Units : m.To == hex ? army + m.Units : army);

    /// <summary>The units on a tile that can still move: those that started the round there and aren't moving yet.</summary>
    private Army Movable(Hex hex) =>
        moves.Where(m => m.From == hex).Aggregate(Match.UnitsOn(hex), (army, m) => army - m.Units);

    private IEnumerable<Hex> MoveFroms() =>
        Me.Tiles.Where(h => !Movable(h).IsEmpty && Me.Tiles.Any(h.IsNextTo)).OrderBy(h => h.Q).ThenBy(h => h.R);

    private void AddMove()
    {
        if (Parse(moveFrom) is { } from && Parse(moveTo) is { } to)
        {
            var movable = Movable(from);
            var army = new Army(Math.Clamp(moveImps, 0, movable.Imps), Math.Clamp(moveGolems, 0, movable.Golems));
            if (!army.IsEmpty)
            {
                moves.Add(new Move(from, to, army));
                sends.Clear(); // an attack's sources change with the moves; they default to everything there again
            }
        }

        (moveFrom, moveTo, moveImps, moveGolems) = (string.Empty, string.Empty, 0, 0);
    }

    private void FromChosen()
    {
        var movable = Parse(moveFrom) is { } from ? Movable(from) : Army.None;
        (moveImps, moveGolems) = (movable.Imps, movable.Golems);
    }

    /// <summary>What the folded spell section holds, for its header.</summary>
    private string SpellSummary() => (spell, Parse(spellTarget)) switch
    {
        (null, _) => "none",
        ({ } s, { } on) => $"{s} on {on}",
        ({ } s, null) => $"{s}, choose a tile",
    };

    /// <summary>The line in the action bar: the problem, or the cost all told (the check's last line).</summary>
    private static string ActionSummary(Report? check) => check switch
    {
        null => "Choose what your stance aims at.",
        { Succeeded: false } => check.Lines[0],
        _ => check.Lines[^1],
    };

    private void ChooseSpell(Spell? chosen)
    {
        spell = chosen;
        (spellTarget, scorchPower, leylineTo, leylineImps, leylineGolems) = (string.Empty, 1, string.Empty, 0, 0);
    }

    /// <summary>The units a Leyline can carry from a tile: those that aren't stepping, and any summoned there this round.</summary>
    private Army Riders(Hex hex) =>
        Movable(hex) + (stance == "Summon" && Selected == hex ? Army.Of(kind, Math.Max(0, count)) : Army.None);

    private void SpellTargetChosen()
    {
        var free = Parse(spellTarget) is { } on ? Riders(on) : Army.None;
        (leylineImps, leylineGolems, leylineTo) = (free.Imps, free.Golems, string.Empty);
    }

    private IEnumerable<(Spell Spell, string Cost, string Effect)> SpellChoices()
    {
        var r = Match.Rules;
        yield return (Spell.Scorch, $"{r.ScorchManaPerPower} mana per power that burns", "burn units on a rival's tile next to yours");
        yield return (Spell.Ward, $"{r.WardCost} mana", $"one of your tiles defends with {r.WardPower} more power this round");
        yield return (Spell.Leyline, $"{r.LeylineManaPerUnit} mana per unit, at least {r.LeylineMinCost}", "send units between any two of your tiles");
        yield return (Spell.Blight, $"{r.BlightCost} mana", "a rival's tile next to yours yields nothing next round");
        yield return (Spell.Lure, $"{r.LureCost} mana", $"a monster tile next to yours loses {r.LurePower} guard power for good");
        yield return (Spell.Rally, $"{r.RallyCost} mana", $"your attack this round strikes with {r.RallyPower} more power");
    }

    /// <summary>The tiles a spell can aim at (for a Leyline, where the units leave from).</summary>
    private IEnumerable<Hex> SpellTargets(Spell chosen)
    {
        var nextToYou = Me.Tiles.SelectMany(Match.Map.NeighboursOf).Distinct().ToList();
        var rivals = nextToYou.Where(h => Match.OwnerOf(h) is { } o && o != You);
        var found = chosen switch
        {
            Spell.Scorch => rivals.Where(h => Match.UnitsOn(h).Power(Match.Rules) > 0),
            // Spells come after Attunes and Summons: a Ward can go on the tile being attuned, a Leyline can carry the
            // units being summoned.
            Spell.Ward => stance == "Attune" && Selected is { } attuned ? Me.Tiles.Append(attuned).Distinct() : Me.Tiles,
            Spell.Leyline => Me.Tiles.Count > 1 ? Me.Tiles.Where(h => !Riders(h).IsEmpty) : [],
            Spell.Blight => rivals,
            Spell.Lure => nextToYou.Where(h => Match.OwnerOf(h) is null && Match.Map[h].IsGuarded && Match.Map[h].Guard > Match.Rules.MinGuard),
            Spell.Rally => stance == "Attack" && Selected is { } attacked ? [attacked] : [],
            _ => [],
        };
        return found.OrderBy(h => h.Q).ThenBy(h => h.R);
    }

    private static string Key(Hex hex) => $"{hex.Q},{hex.R}";

    private static Hex? Parse(string key) =>
        key.Split(',') is [var q, var r] && int.TryParse(q, CultureInfo.InvariantCulture, out var qq)
        && int.TryParse(r, CultureInfo.InvariantCulture, out var rr) ? new Hex(qq, rr) : null;

    private RenderFragment Targets(IEnumerable<Hex> hexes) => __builder =>
    {
        var list = hexes.ToList();
        if (list.Count == 0)
        {
            <p class="text-muted">None this round.</p>
            return;
        }

        foreach (var hex in list)
        {
            var h = hex;
            <label class="choice">
                <input type="radio" name="target" checked="@(Selected == h)" @onchange="() => OnSelect.InvokeAsync(h)" />
                <span>@Seats.Describe(Match, h, You, Owners)</span>
            </label>
        }
    };

    private IEnumerable<Hex> FreeNextToYou() =>
        Me.Tiles.SelectMany(Match.Map.NeighboursOf).Distinct()
            .Where(h => Match.Map[h].IsUnveiled && !Match.Map[h].IsGuarded && Match.OwnerOf(h) is null)
            .OrderBy(h => h.Q).ThenBy(h => h.R);

    private IReadOnlyList<Hex> AttackTargets() =>
        [.. Me.Tiles.Where(h => !AfterMoves(h).IsEmpty).SelectMany(Match.Map.NeighboursOf).Distinct()
            .Where(h => Match.OwnerOf(h) is { } o ? o != You : Match.Map[h].IsGuarded)
            .OrderBy(h => h.Q).ThenBy(h => h.R)];

    private IEnumerable<Hex> Sources(Hex target) =>
        Me.Tiles.Where(h => h.IsNextTo(target) && !AfterMoves(h).IsEmpty).OrderBy(h => h.Q).ThenBy(h => h.R);

    private void Send(Hex from, Army army) => sends[from] = army;

    private static int Parse(ChangeEventArgs e, int max) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) ? Math.Clamp(n, 0, max) : 0;
}
