@inherits LayoutComponentBase

<header class="top-bar">
    <a class="brand" href="">Spellbound</a>
    <AuthorizeView>
        <Authorized>
            <AuthorizeView Policy="@AdminPolicy.Name" Context="admin">
                <a href="admin">Admin</a>
            </AuthorizeView>
            <a href="Account/Manage">Account</a>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-link">Sign out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a href="Account/Login">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
</header>

<main class="content">
    @Body
</main>

<AuthorizeView>
    <nav class="bottom-nav" aria-label="Game">
        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink href="explore">Explore</NavLink>
        <NavLink href="build">Build</NavLink>
        <NavLink href="magic">Magic</NavLink>
        <NavLink href="army">Army</NavLink>
        <NavLink href="rivals">Rivals</NavLink>
    </nav>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
