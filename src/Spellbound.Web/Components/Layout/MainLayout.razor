@inherits LayoutComponentBase

@* The page is inked in the theme's soft ink; a game can set data-school on this wrapper to tint the accents
   (docs/theme.md). It takes no space. *@
<div class="school-ink">
<GrimFilters />

<header class="top-bar">
    <a class="brand" href="" title="Home">Spellbound</a>
    <AuthorizeView>
        <Authorized>
            <AuthorizeView Policy="@AdminPolicy.Name" Context="admin">
                <a href="admin">Admin</a>
            </AuthorizeView>
            <a href="Account/Manage">Account</a>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-link">Sign out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <a href="Account/Login">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
</header>

<main class="content">
    @Body
    <footer class="site-footer">
        <a href="privacy">Privacy</a>
    </footer>
</main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
