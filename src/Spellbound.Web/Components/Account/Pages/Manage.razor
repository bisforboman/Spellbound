@page "/Account/Manage"

@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Spellbound.Web.Hosting

@attribute [Authorize]
@inject AccountService Accounts

<PageTitle>Account</PageTitle>

<h1>Account</h1>

@if (account is not null)
{
    <table class="table stats">
        <tbody>
            <tr><th>Email</th><td>@account.Email</td></tr>
            <tr><th>Signs in with</th><td>@(account.Provider == AccountEndpoints.GoogleProvider ? "Google" : account.Provider)</td></tr>
            <tr><th>Since</th><td>@account.CreatedAt.UtcDateTime.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td></tr>
        </tbody>
    </table>
    <p class="text-muted">Your email comes from your sign-in and updates each time you sign in.</p>
}

<h2 class="h4 mt-4">Notifications</h2>
<p>
    Get a notification on this phone or computer when it's your move in a Skirmish: when everyone else is ready, when a
    round's time is running out, and when a round has played. Turn them on separately on each device.
</p>
<p role="status" data-push-status>Checking…</p>
@if (Push == "sent")
{
    <p class="alert alert-success" role="status">A test notification is on its way to every device where they're on.</p>
}
<form id="push-form" action="Account/Push/Test" method="post">
    <AntiforgeryToken />
    <button type="button" class="btn btn-primary btn-lg w-100" data-push="on">Turn on notifications here</button>
    <button type="submit" class="btn btn-outline-primary btn-lg w-100 mt-2">Send me a test notification</button>
    <button type="button" class="btn btn-link w-100" data-push="off">Turn them off here</button>
</form>

<h2 class="h4 mt-4">Your data</h2>
<p>
    Download everything the game stores about you as one file: your account, your recent sign-in networks (as hashes),
    your mages, news and actions in every round, your Skirmish games, and the devices where notifications are on. See the <a href="privacy">privacy notice</a> for what each is for.
</p>
<a class="btn btn-outline-primary btn-lg w-100" href="Account/Data" download>Download my data</a>

<h2 class="h4 mt-4">Delete your account</h2>
<p>
    This deletes your account and your mages, news and logged actions in every round, at once and for good. Halls of fame from finished
    rounds keep your mage's name.
</p>
@if (Error == "confirm")
{
    <p class="alert alert-danger" role="alert">Type "delete" to confirm.</p>
}
<form action="Account/Delete" method="post">
    <AntiforgeryToken />
    <label class="form-label" for="confirm">Type <b>delete</b> to confirm</label>
    <input id="confirm" name="confirm" class="form-control" autocomplete="off" required />
    <button type="submit" class="btn btn-danger btn-lg w-100 mt-2">Delete my account</button>
</form>

@code {
    private Account? account;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? Push { get; set; }

    protected override async Task OnInitializedAsync() =>
        account = await Accounts.FindAsync(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty);
}
