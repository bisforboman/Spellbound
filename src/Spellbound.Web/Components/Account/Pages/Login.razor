@page "/Account/Login"

@using Spellbound.Web.Hosting

@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment

<PageTitle>Sign in</PageTitle>

<h1>Sign in</h1>

@if (Deleted is not null)
{
    <p class="alert alert-success">Your account and your mages are deleted.</p>
}

@if (Error is { Length: > 0 })
{
    <p class="alert alert-danger" role="alert">@Error</p>
}

<p>Sign in to play. Your first sign-in creates your account; there's no password to remember.</p>
<p class="text-muted">By signing in you accept the <a href="privacy">privacy notice</a>: what the game stores and why.</p>

@if (AccountEndpoints.GoogleConfigured(Configuration))
{
    <form action="Account/ExternalLogin" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnPath" />
        <button type="submit" class="btn btn-primary btn-lg w-100">Sign in with Google</button>
    </form>
}

@if (Environment.IsDevelopment())
{
    <h2 class="h5 mt-4">Development sign-in</h2>
    <p class="text-muted">Only in Development: sign in as any email, no Google needed.</p>
    <form action="Account/DevSignIn" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="returnUrl" value="@ReturnPath" />
        <label class="form-label" for="email">Email</label>
        <input id="email" name="email" type="email" class="form-control" required autocomplete="email" />
        <button type="submit" class="btn btn-outline-primary btn-lg w-100 mt-2">Sign in</button>
    </form>
}

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? Deleted { get; set; }

    /// <summary>Where to go after signing in, as a site path (the endpoints refuse anything else).</summary>
    private string ReturnPath =>
        ReturnUrl is { Length: > 0 } url && Uri.TryCreate(url, UriKind.Absolute, out var absolute) ? absolute.PathAndQuery
        : ReturnUrl is { Length: > 0 } relative ? "/" + relative.TrimStart('/')
        : "/";
}
