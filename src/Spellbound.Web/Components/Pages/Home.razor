@page "/"
@attribute [Authorize]
@using System.Security.Claims
@using Spellbound.Web.Data
@inject MatchStore Matches
@inject MatchLobbies Lobbies

<PageTitle>Spellbound</PageTitle>
<h1>Spellbound</h1>

<p>A dark map, an opening mana auction, eight rounds of secret stances. Play against bots, or invite friends.</p>
<a class="btn btn-primary btn-lg w-100" href="match/new">New match</a>

@if (invites is { Count: > 0 })
{
    <h2 class="h4 mt-4">Your invites</h2>
    <ul class="match-list">
        @foreach (var invite in invites)
        {
            <li><a href="join/@invite.Code">@(invite.IsHost ? "Your invite" : "An invite")</a> for @invite.Seats players: @invite.Joined joined, not started.</li>
        }
    </ul>
}

<h2 class="h4 mt-4">Your matches</h2>
@if (matches is null)
{
    <p class="text-muted">Loading…</p>
}
else if (matches.Count == 0)
{
    <p class="text-muted">You aren't in a match yet.</p>
}
else
{
    <ul class="match-list">
        @foreach (var match in matches)
        {
            <li><a href="match/@match.Id">Match @match.Id</a>, seat @(match.Seat + 1): @match.Description</li>
        }
    </ul>
}
<p><a href="Account/Manage">Your account</a></p>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<PlayerMatch>? matches;
    private IReadOnlyList<PlayerLobby>? invites;

    protected override async Task OnInitializedAsync()
    {
        var ownerId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier);
        matches = ownerId is null ? [] : await Matches.ListForAsync(ownerId);
        invites = ownerId is null ? [] : await Lobbies.ListForAsync(ownerId);
    }
}
