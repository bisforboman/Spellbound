# Copy to .env on the server and fill in. .env is gitignored: never commit it, the repository is public.

# The domain players use. Its DNS A (and AAAA) record must point at this server before the first start.
DOMAIN=spellbound.example.com

# Email of the account that may use /admin (the Google account you sign in with).
ADMIN_EMAIL=you@example.com

# The database password. Only the app uses it (the database has no open port). Pick a long random one of letters and
# digits only (it goes into a connection string, where ; = and quotes break it), e.g. with
#   openssl rand -hex 24
# and set it before the first start: the database keeps the password it was created with.
POSTGRES_PASSWORD=change-me

# Google sign-in: an OAuth client from Google Cloud Console (see docs/deploy.md, "Google sign-in").
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# The privacy notice (/privacy). Read it before launch: you run the game, so you're responsible for the data.
PRIVACY_OPERATOR=Your Name
PRIVACY_CONTACT=you@example.com
PRIVACY_HOSTING=a rented server in Germany (Hetzner)
# Optional: where you keep copies of the backups, and for how long (see docs/deploy.md, Backups).
PRIVACY_OFFSITE_BACKUPS=
