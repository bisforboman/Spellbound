# Copy to .env on the server and fill in. .env is gitignored: never commit it, the repository is public.

# The domain players use. Its DNS A (and AAAA) record must point at this server before the first start.
DOMAIN=spellbound.example.com

# Email of the account that may use /admin (register it in the game first).
ADMIN_EMAIL=you@example.com

# The database password. Only the app uses it (the database has no open port). Pick a long random one, e.g. with
#   openssl rand -hex 24
# and set it before the first start: the database keeps the password it was created with.
POSTGRES_PASSWORD=change-me
